# ---------------------------------------------------------------------------
# Audit — check project context injection compliance
# ---------------------------------------------------------------------------

cmd_audit() {
  local json_out=false fix_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      --fix)  fix_mode=true; shift ;;
      --help|-h) echo "Usage: jt audit [--json] [--fix]"; echo ""; echo "Check project context injection compliance."; echo "Validates: thin CLAUDE.md, Project Index base, Tech Stack base."; echo ""; echo "Options:"; echo "  --json    Output results as JSON"; echo "  --fix     Print fix commands for failing checks"; return 0 ;;
      *) shift ;;
    esac
  done

  local project_name
  project_name="$(basename "$PROJECT_ROOT")"
  local checks_passed=0 checks_failed=0 checks_warned=0
  local issues=() warnings=() fixes=()

  # Check 1: CLAUDE.md exists and is thin (< 100 lines)
  local claude_md="$PROJECT_ROOT/CLAUDE.md"
  if [[ -f "$claude_md" ]]; then
    local lines
    lines=$(wc -l < "$claude_md")
    if (( lines > 100 )); then
      issues+=("CLAUDE.md is $lines lines (should be < 100)")
      fixes+=("Run /jat:migrate to extract context into knowledge bases")
      checks_failed=$((checks_failed + 1))
    elif (( lines > 50 )); then
      warnings+=("CLAUDE.md is $lines lines (ideally < 50)")
      checks_warned=$((checks_warned + 1))
    else
      checks_passed=$((checks_passed + 1))
    fi
  else
    warnings+=("No CLAUDE.md found")
    checks_warned=$((checks_warned + 1))
  fi

  # Check 2: CLAUDE.md points to JAT bases (contains "jt bases" or "knowledge bases")
  if [[ -f "$claude_md" ]]; then
    if grep -qi 'jt bases\|knowledge bases\|JAT.*bases' "$claude_md" 2>/dev/null; then
      checks_passed=$((checks_passed + 1))
    else
      issues+=("CLAUDE.md doesn't reference JAT knowledge bases")
      fixes+=("Add: 'Full project context is in JAT knowledge bases — run \`jt bases list\` to see all available context.'")
      checks_failed=$((checks_failed + 1))
    fi
  fi

  # Check 3: Project Index always-inject base exists
  if [[ -f "$BASES_DB" ]]; then
    local pi_count
    pi_count=$(sqlite3 "$BASES_DB" "SELECT COUNT(*) FROM bases WHERE always_inject = 1 AND lower(name) LIKE '%project index%';" 2>/dev/null || echo "0")
    if (( pi_count > 0 )); then
      checks_passed=$((checks_passed + 1))
    else
      issues+=("No 'Project Index' always-inject base found")
      fixes+=("jt bases create --name \"Project Index\" --type manual --always-inject --content \"...\"")
      checks_failed=$((checks_failed + 1))
    fi
  else
    issues+=("No data database (.jat/data.db)")
    fixes+=("jt init && jt bases create --name \"Project Index\" --type manual --always-inject --content \"...\"")
    checks_failed=$((checks_failed + 1))
  fi

  # Check 4: Tech Stack always-inject base exists
  if [[ -f "$BASES_DB" ]]; then
    local ts_count
    ts_count=$(sqlite3 "$BASES_DB" "SELECT COUNT(*) FROM bases WHERE always_inject = 1 AND lower(name) LIKE '%tech stack%';" 2>/dev/null || echo "0")
    if (( ts_count > 0 )); then
      checks_passed=$((checks_passed + 1))
    else
      issues+=("No 'Tech Stack' always-inject base found")
      fixes+=("jt bases create --name \"Tech Stack\" --type manual --always-inject --content \"...\"")
      checks_failed=$((checks_failed + 1))
    fi
  fi

  # Check 5: At least one knowledge base exists
  if [[ -f "$BASES_DB" ]]; then
    local base_count
    base_count=$(sqlite3 "$BASES_DB" "SELECT COUNT(*) FROM bases;" 2>/dev/null || echo "0")
    if (( base_count > 0 )); then
      checks_passed=$((checks_passed + 1))
    else
      issues+=("No knowledge bases found")
      fixes+=("Run /jat:migrate or /jat:onboard to create knowledge bases")
      checks_failed=$((checks_failed + 1))
    fi
  fi

  # Output
  if $json_out; then
    local issues_json="[]" warnings_json="[]" fixes_json="[]"
    if (( ${#issues[@]} > 0 )); then
      issues_json=$(printf '%s\n' "${issues[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")
    fi
    if (( ${#warnings[@]} > 0 )); then
      warnings_json=$(printf '%s\n' "${warnings[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")
    fi
    if (( ${#fixes[@]} > 0 )); then
      fixes_json=$(printf '%s\n' "${fixes[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")
    fi
    python3 -c "
import json
print(json.dumps({
  'project': '$project_name',
  'path': '$PROJECT_ROOT',
  'passed': $checks_passed,
  'failed': $checks_failed,
  'warned': $checks_warned,
  'compliant': $checks_failed == 0,
  'issues': $issues_json,
  'warnings': $warnings_json,
  'fixes': $fixes_json
}))
"
  else
    local total=$((checks_passed + checks_failed + checks_warned))

    if (( checks_failed == 0 && checks_warned == 0 )); then
      echo "  $project_name: COMPLIANT ($checks_passed/$total checks passed)"
    elif (( checks_failed == 0 )); then
      echo "  $project_name: OK ($checks_passed passed, $checks_warned warnings)"
      for w in "${warnings[@]}"; do
        echo "    ! $w"
      done
    else
      echo "  $project_name: NEEDS WORK ($checks_failed issues, $checks_warned warnings)"
      for i in "${issues[@]}"; do
        echo "    x $i"
      done
      for w in "${warnings[@]}"; do
        echo "    ! $w"
      done
    fi

    if $fix_mode && (( ${#fixes[@]} > 0 )); then
      echo ""
      echo "  Fixes:"
      for f in "${fixes[@]}"; do
        echo "    $ $f"
      done
    fi
  fi

  # Exit code: 0 if compliant, 1 if issues
  (( checks_failed == 0 ))
}

# ---------------------------------------------------------------------------
# Spawn — Spawn an agent session via IDE API
# ---------------------------------------------------------------------------

cmd_spawn() {
  local task_id="" model="" project="" attach=false
  local force_local=false force_remote=false
  local ide_url="http://127.0.0.1:3333"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote)   force_remote=true; shift ;;
      --local)    force_local=true; shift ;;
      --model)    model="$2"; shift 2 ;;
      --project)  project="$2"; shift 2 ;;
      --attach)   attach=true; shift ;;
      --help|-h)
        cat <<'SPAWN_HELP'
jt spawn - Spawn an agent session

Usage:
  jt spawn [TASK_ID] [--remote] [--local] [--model MODEL] [--attach]

Options:
  --remote      Force spawn on VPS (regardless of local slot availability)
  --local       Force spawn locally (even if slots are full)
  --model M     Model override: opus, sonnet, haiku (default: from config)
  --project P   Project name (inferred from task if omitted)
  --attach      Open terminal attached to session immediately

Without --remote or --local, auto-routing applies:
  local slots available → spawn locally
  local slots full + VPS configured → spawn on VPS

Examples:
  jt spawn jat-abc123              Auto-route agent for task
  jt spawn jat-abc123 --remote     Force to VPS (overnight work, save local resources)
  jt spawn jat-abc123 --local      Force local even if slots full
  jt spawn --remote --model opus   Planning session on VPS with opus
SPAWN_HELP
        return 0
        ;;
      -*)  die "Unknown option: $1. Run 'jt spawn --help' for usage." ;;
      *)   task_id="$1"; shift ;;
    esac
  done

  if $force_local && $force_remote; then
    die "Cannot use both --remote and --local"
  fi

  # Check IDE is reachable
  if ! curl -sf --max-time 2 "${ide_url}/" >/dev/null 2>&1; then
    die "IDE not running at ${ide_url}. Start with: jat"
  fi

  # Build JSON body
  local body="{}"
  [[ -n "$task_id" ]]  && body=$(echo "$body" | jq --arg v "$task_id" '. + {taskId: $v}')
  [[ -n "$model" ]]    && body=$(echo "$body" | jq --arg v "$model" '. + {model: $v}')
  [[ -n "$project" ]]  && body=$(echo "$body" | jq --arg v "$project" '. + {project: $v}')
  $attach              && body=$(echo "$body" | jq '. + {attach: true}')
  $force_local         && body=$(echo "$body" | jq '. + {forceLocal: true}')
  $force_remote        && body=$(echo "$body" | jq '. + {forceRemote: true}')

  # Spawn via IDE API
  local response http_code
  response=$(curl -sf --max-time 30 -w '\n%{http_code}' \
    -X POST "${ide_url}/api/work/spawn" \
    -H "Content-Type: application/json" \
    -d "$body" 2>&1) || true

  http_code=$(echo "$response" | tail -1)
  local body_out
  body_out=$(echo "$response" | sed '$d')

  if [[ "$http_code" != "200" ]]; then
    local error_msg
    error_msg=$(echo "$body_out" | jq -r '.error // .message // "Unknown error"' 2>/dev/null || echo "$body_out")
    die "Spawn failed (HTTP ${http_code}): ${error_msg}"
  fi

  # Parse success response
  local agent_name session_name is_remote
  agent_name=$(echo "$body_out" | jq -r '.session.agentName // "unknown"')
  session_name=$(echo "$body_out" | jq -r '.session.sessionName // "unknown"')
  is_remote=$(echo "$body_out" | jq -r '.session.remote // false')

  local location="local" location_icon="💻"
  if [[ "$is_remote" == "true" ]]; then
    location="remote"
    location_icon="☁️"
  fi

  echo "${location_icon} Spawned ${agent_name} (${session_name})"
  [[ -n "$task_id" ]] && echo "   Task: ${task_id}"
  echo "   Location: ${location}"
  [[ -n "$model" ]] && echo "   Model: ${model}"

  if $attach; then
    echo "   Attaching..."
  else
    echo "   Attach: tmux attach -t ${session_name}"
  fi
}

# ---------------------------------------------------------------------------
# SSH — Quick VPS connect
# ---------------------------------------------------------------------------

_read_jat_config() {
  local config_file="${HOME}/.config/jat/projects.json"
  [[ -f "$config_file" ]] || die "JAT config not found: $config_file"
  cat "$config_file"
}

cmd_ssh() {
  local agent_name="" list_mode=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list|-l) list_mode=true; shift ;;
      --help|-h)
        cat <<'SSH_HELP'
jt ssh - Quick VPS connect

Usage:
  jt ssh                    Connect to configured VPS
  jt ssh <agent-name>       Attach to remote agent's tmux session
  jt ssh --list             List tmux sessions on VPS

Config (in ~/.config/jat/projects.json defaults):
  vps_host    VPS IP or hostname (e.g. Tailscale IP)
  vps_user    SSH username
SSH_HELP
        return 0
        ;;
      *) agent_name="$1"; shift ;;
    esac
  done

  local config
  config="$(_read_jat_config)"

  local vps_host vps_user
  vps_host="$(echo "$config" | jq -r '.defaults.vps_host // empty')"
  vps_user="$(echo "$config" | jq -r '.defaults.vps_user // empty')"

  [[ -n "$vps_host" ]] || die "No vps_host configured. Set defaults.vps_host in ~/.config/jat/projects.json"
  [[ -n "$vps_user" ]] || die "No vps_user configured. Set defaults.vps_user in ~/.config/jat/projects.json"

  local ssh_target="${vps_user}@${vps_host}"

  if $list_mode; then
    echo "Tmux sessions on ${ssh_target}:"
    ssh -t "$ssh_target" "tmux list-sessions 2>/dev/null || echo '  (no sessions)'"
    return 0
  fi

  if [[ -n "$agent_name" ]]; then
    local tmux_session="jat-${agent_name}"
    echo "Attaching to ${tmux_session} on ${ssh_target}..."
    exec ssh -t "$ssh_target" "tmux attach-session -t ${tmux_session}"
  else
    echo "Connecting to VPS ${ssh_target}..."
    exec ssh "$ssh_target"
  fi
}

# ---------------------------------------------------------------------------
# Agents — List active agents with real-time state
# ---------------------------------------------------------------------------

cmd_agents() {
  local json_mode=false
  local project_filter=""
  local all_mode=false
  local remote_only=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)    json_mode=true; shift ;;
      --project) project_filter="$2"; shift 2 ;;
      --all)     all_mode=true; shift ;;
      --remote)  remote_only=true; shift ;;
      --help|-h) cat <<'EOF'
jt agents - List active agents (local + remote)

Usage: jt agents [--json] [--project NAME] [--all] [--remote]

Options:
  --json       Output as JSON array
  --project X  Filter by project name
  --all        Include inactive agents (no live tmux session)
  --remote     Show only remote (VPS) agents

Sources:
  Local tmux     Which agents are alive locally (jat-* sessions)
  Remote tmux    VPS agents via SSH (if vps_host configured)
  Signal files   Real-time state: working, review, needs_input, etc.
  tasks.db       Assigned task, reserved files
  agent-mail.db  Program, model, registration info
EOF
        return 0 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  local agent_mail_db="${AGENT_MAIL_DB:-$HOME/.agent-mail.db}"

  # Collect live LOCAL tmux sessions (jat-AgentName pattern)
  local -a live_sessions=()
  local -a remote_sessions=()

  if ! $remote_only; then
    while IFS= read -r session; do
      local agent_name="${session#jat-}"
      if [[ "$agent_name" =~ ^[A-Z] ]]; then
        live_sessions+=("$agent_name")
      fi
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^jat-' || true)
  fi

  # Collect REMOTE tmux sessions from VPS (if configured)
  local vps_host="" vps_user=""
  local config_file="${HOME}/.config/jat/projects.json"
  if [[ -f "$config_file" ]]; then
    vps_host="$(jq -r '.defaults.vps_host // empty' "$config_file")"
    vps_user="$(jq -r '.defaults.vps_user // empty' "$config_file")"
  fi

  declare -A remote_signal_data  # agent_name -> signal JSON
  if [[ -n "$vps_host" && -n "$vps_user" ]]; then
    local ssh_target="${vps_user}@${vps_host}"
    # Single SSH call: list sessions + read all signal files
    local remote_data
    remote_data=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$ssh_target" '
      echo "---SESSIONS---"
      tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^jat-" || true
      echo "---SIGNALS---"
      for f in /tmp/jat-signal-tmux-jat-*.json; do
        [ -f "$f" ] || continue
        agent=$(basename "$f" | sed "s/^jat-signal-tmux-jat-//;s/\.json$//")
        echo "AGENT:${agent}"
        cat "$f"
        echo ""
      done
    ' 2>/dev/null || true)

    if [[ -n "$remote_data" ]]; then
      local in_sessions=false in_signals=false current_agent=""
      local signal_json=""
      while IFS= read -r line; do
        if [[ "$line" == "---SESSIONS---" ]]; then
          in_sessions=true; in_signals=false; continue
        elif [[ "$line" == "---SIGNALS---" ]]; then
          in_sessions=false; in_signals=true; continue
        fi

        if $in_sessions && [[ -n "$line" ]]; then
          local rname="${line#jat-}"
          if [[ "$rname" =~ ^[A-Z] ]]; then
            # Skip if already in local sessions
            local is_local=false
            for ls in "${live_sessions[@]}"; do
              [[ "$ls" == "$rname" ]] && is_local=true && break
            done
            $is_local || remote_sessions+=("$rname")
          fi
        fi

        if $in_signals; then
          if [[ "$line" == AGENT:* ]]; then
            if [[ -n "$current_agent" && -n "$signal_json" ]]; then
              remote_signal_data["$current_agent"]="$signal_json"
            fi
            current_agent="${line#AGENT:}"
            signal_json=""
          elif [[ -n "$current_agent" ]]; then
            signal_json+="$line"
          fi
        fi
      done <<< "$remote_data"
      if [[ -n "$current_agent" && -n "$signal_json" ]]; then
        remote_signal_data["$current_agent"]="$signal_json"
      fi
    fi
  fi

  # Build agent list with location tracking
  local -a agent_list=()
  declare -A agent_location  # agent_name -> "local" | "remote"

  if $all_mode && [[ -f "$agent_mail_db" ]]; then
    while IFS= read -r name; do
      agent_list+=("$name")
      agent_location["$name"]="local"
    done < <(sqlite3 "$agent_mail_db" "SELECT name FROM agents ORDER BY last_active_ts DESC LIMIT 50" 2>/dev/null || true)
    for name in "${live_sessions[@]}"; do
      local found=false
      for existing in "${agent_list[@]}"; do
        [[ "$existing" == "$name" ]] && found=true && break
      done
      $found || agent_list+=("$name")
      agent_location["$name"]="local"
    done
  elif ! $remote_only; then
    for name in "${live_sessions[@]}"; do
      agent_list+=("$name")
      agent_location["$name"]="local"
    done
  fi

  # Add remote sessions
  for name in "${remote_sessions[@]}"; do
    local found=false
    for existing in "${agent_list[@]}"; do
      [[ "$existing" == "$name" ]] && found=true && break
    done
    $found || agent_list+=("$name")
    agent_location["$name"]="remote"
  done

  if [[ ${#agent_list[@]} -eq 0 ]]; then
    $json_mode && echo "[]" || echo "No active agents found."
    return 0
  fi

  # Build JSON array from multiple data sources per agent
  local json_out="["
  local first=true

  for agent_name in "${agent_list[@]}"; do
    local location="${agent_location[$agent_name]:-local}"
    local signal_file="/tmp/jat-signal-tmux-jat-${agent_name}.json"

    # Is this agent alive?
    local alive=false
    if [[ "$location" == "remote" ]]; then
      for s in "${remote_sessions[@]}"; do
        [[ "$s" == "$agent_name" ]] && alive=true && break
      done
    else
      for s in "${live_sessions[@]}"; do
        [[ "$s" == "$agent_name" ]] && alive=true && break
      done
    fi

    # Read signal data — remote from SSH cache, local from file
    local state="" task_id="" task_title="" sig_project="" sig_model=""
    local git_branch="" approach=""
    local sig_json=""
    if [[ "$location" == "remote" && -n "${remote_signal_data[$agent_name]:-}" ]]; then
      sig_json="${remote_signal_data[$agent_name]}"
    elif [[ "$location" == "local" && -f "$signal_file" ]]; then
      sig_json="$(cat "$signal_file" 2>/dev/null || true)"
    fi

    if [[ -n "$sig_json" ]]; then
      local sig_data
      sig_data=$(python3 -c "
import json, sys
try:
    s = json.loads(sys.argv[1])
    d = s.get('data', {})
    print(s.get('state', ''))
    print(s.get('task_id', '') or d.get('taskId', ''))
    print(d.get('taskTitle', ''))
    print(d.get('project', ''))
    print(d.get('model', ''))
    print(d.get('gitBranch', ''))
    print(d.get('approach', ''))
except: print('\n\n\n\n\n\n')
" "$sig_json" 2>/dev/null || printf '\n\n\n\n\n\n')
      {
        IFS= read -r state || true
        IFS= read -r task_id || true
        IFS= read -r task_title || true
        IFS= read -r sig_project || true
        IFS= read -r sig_model || true
        IFS= read -r git_branch || true
        IFS= read -r approach || true
      } <<< "$sig_data"
    fi

    # Derive project from task_id prefix if not in signal data
    if [[ -z "$sig_project" && -n "$task_id" ]]; then
      sig_project="${task_id%%-*}"
    fi

    # Apply project filter
    if [[ -n "$project_filter" && "$sig_project" != "$project_filter" ]]; then
      continue
    fi

    # Read from agent-mail.db for program/model
    local program=""
    if [[ -f "$agent_mail_db" ]]; then
      local am_data
      am_data=$(sqlite3 "$agent_mail_db" "SELECT program, model FROM agents WHERE name='$(sql_escape "$agent_name")' LIMIT 1" 2>/dev/null || echo "|")
      program="${am_data%%|*}"
      [[ -z "$sig_model" ]] && sig_model="${am_data#*|}"
    fi

    # Read reserved files from tasks.db
    local reserved_files=""
    if [[ -n "$task_id" && -f "$DB" ]]; then
      reserved_files=$(sqlite3 "$DB" "SELECT COALESCE(reserved_files,'') FROM tasks WHERE id='$(sql_escape "$task_id")'" 2>/dev/null || echo "")
    fi

    # Shorten model name for display
    local model_short="$sig_model"
    model_short="${model_short/claude-opus-4-6/opus}"
    model_short="${model_short/claude-sonnet-4-6/sonnet}"
    model_short="${model_short/claude-haiku-4-5-20251001/haiku}"
    model_short="${model_short/claude-opus-4-5-20251101/opus}"
    model_short="${model_short/claude-sonnet-4-5-20250514/sonnet}"

    # Build JSON object
    $first || json_out+=","
    first=false
    json_out+=$(python3 -c "
import json, sys
d = {
    'name': sys.argv[1],
    'alive': sys.argv[2] == 'true',
    'state': sys.argv[3] or None,
    'taskId': sys.argv[4] or None,
    'taskTitle': sys.argv[5] or None,
    'project': sys.argv[6] or None,
    'model': sys.argv[7] or None,
    'program': sys.argv[8] or None,
    'gitBranch': sys.argv[9] or None,
    'reservedFiles': sys.argv[10] or None,
    'approach': sys.argv[11] or None,
    'location': sys.argv[12]
}
print(json.dumps(d))
" "$agent_name" "$alive" "$state" "$task_id" "$task_title" "$sig_project" "$model_short" "$program" "$git_branch" "$reserved_files" "$approach" "$location" 2>/dev/null)
  done

  json_out+="]"

  if $json_mode; then
    echo "$json_out"
    return 0
  fi

  # Formatted table output with location column
  printf "\033[1m%-16s %-8s %-10s %-14s %-8s %-10s %s\033[0m\n" "AGENT" "LOC" "STATE" "TASK" "MODEL" "PROJECT" "FILES"
  printf "%-16s %-8s %-10s %-14s %-8s %-10s %s\n" "─────" "───" "─────" "────" "─────" "───────" "─────"

  echo "$json_out" | python3 -c "
import json, sys
agents = json.load(sys.stdin)
colors = {
    'working': '\033[33m',
    'starting': '\033[36m',
    'review': '\033[32m',
    'needs_input': '\033[35m',
    'idle': '\033[90m',
    'completing': '\033[32m',
    'dead': '\033[90m',
}
reset = '\033[0m'
cloud = '\u2601'
local_icon = '\u2302'
for a in agents:
    state = a['state'] or ''
    if not a['alive'] and state:
        state = 'dead'
    color = colors.get(state, '')
    name = a['name'] or ''
    task = a['taskId'] or ''
    model = a['model'] or ''
    project = a['project'] or ''
    files = a['reservedFiles'] or ''
    loc = cloud + ' VPS' if a.get('location') == 'remote' else local_icon + ' local'
    print(f'{color}{name:<16s} {loc:<8s} {state:<10s} {task:<14s} {model:<8s} {project:<10s} {files}{reset}')
"
}

# ---------------------------------------------------------------------------
# Logs — Stream agent tmux session output (local or remote)
# ---------------------------------------------------------------------------

cmd_logs() {
  local agent_name="" follow_mode=false remote_mode=false lines=100

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f) follow_mode=true; shift ;;
      --remote|-r) remote_mode=true; shift ;;
      --lines|-n)  lines="$2"; shift 2 ;;
      --help|-h)
        cat <<'LOGS_HELP'
jt logs - Stream agent tmux session output

Usage:
  jt logs <agent-name>               Stream local agent output
  jt logs <agent-name> --remote      Stream remote (VPS) agent output
  jt logs <agent-name> --follow      Continuous streaming (tail -f style)
  jt logs <agent-name> --lines 200   Number of lines to capture (default: 100)

Auto-detection:
  Without --remote, tries local tmux first. If the agent isn't found
  locally and VPS is configured, automatically tries the VPS.

Config (in ~/.config/jat/projects.json defaults):
  vps_host    VPS IP or hostname
  vps_user    SSH username
LOGS_HELP
        return 0
        ;;
      *) agent_name="$1"; shift ;;
    esac
  done

  [[ -n "$agent_name" ]] || die "Usage: jt logs <agent-name> [--remote] [--follow] [--lines N]"

  local tmux_session="jat-${agent_name}"

  # Helper: capture from local tmux
  _logs_local() {
    tmux capture-pane -p -e -t "$tmux_session" -S "-${lines}" 2>/dev/null
  }

  # Helper: capture from remote tmux via SSH
  _logs_remote() {
    local config
    config="$(_read_jat_config)"
    local vps_host vps_user
    vps_host="$(echo "$config" | jq -r '.defaults.vps_host // empty')"
    vps_user="$(echo "$config" | jq -r '.defaults.vps_user // empty')"
    [[ -n "$vps_host" ]] || die "No vps_host configured. Set defaults.vps_host in ~/.config/jat/projects.json"
    [[ -n "$vps_user" ]] || die "No vps_user configured. Set defaults.vps_user in ~/.config/jat/projects.json"
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "${vps_user}@${vps_host}" \
      "tmux capture-pane -p -e -t '${tmux_session}' -S '-${lines}' 2>/dev/null"
  }

  # Determine location
  local location=""
  if $remote_mode; then
    location="remote"
  elif tmux has-session -t "$tmux_session" 2>/dev/null; then
    location="local"
  else
    # Auto-detect: not found locally, try remote if VPS configured
    local config_file="${HOME}/.config/jat/projects.json"
    if [[ -f "$config_file" ]]; then
      local vps_host
      vps_host="$(jq -r '.defaults.vps_host // empty' "$config_file")"
      if [[ -n "$vps_host" ]]; then
        echo "Agent '${agent_name}' not found locally, trying VPS..." >&2
        location="remote"
      else
        die "Session '${tmux_session}' not found locally and no VPS configured"
      fi
    else
      die "Session '${tmux_session}' not found"
    fi
  fi

  if $follow_mode; then
    # Continuous streaming: poll every 1 second
    local location_label
    [[ "$location" == "remote" ]] && location_label="☁ VPS" || location_label="local"
    echo "Streaming ${agent_name} (${location_label})... Press Ctrl+C to stop" >&2
    local prev_hash=""
    while true; do
      local output
      if [[ "$location" == "remote" ]]; then
        output="$(_logs_remote 2>/dev/null)" || { echo "Connection lost" >&2; exit 1; }
      else
        output="$(_logs_local 2>/dev/null)" || { echo "Session ended" >&2; exit 0; }
      fi
      local cur_hash
      cur_hash="$(echo "$output" | md5sum | cut -d' ' -f1)"
      if [[ "$cur_hash" != "$prev_hash" ]]; then
        clear
        echo "$output"
        prev_hash="$cur_hash"
      fi
      sleep 1
    done
  else
    # Single capture
    if [[ "$location" == "remote" ]]; then
      _logs_remote
    else
      _logs_local
    fi
  fi
}

# ---------------------------------------------------------------------------
# Graduate command — shells out to Node entry point (postgres adapter is
# async; bash jt is sqlite-only per nsa33.4). Argument handling happens
# inside jt-graduate; this wrapper only passes them through.
# ---------------------------------------------------------------------------

cmd_graduate() {
  local script_dir
  script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  PROJECT_ROOT="$PROJECT_ROOT" exec node "$script_dir/jt-graduate" "$@"
}

# ---------------------------------------------------------------------------
# Downgrade command — reverse of graduate. Moves a project's tasks from
# shared Postgres back to local SQLite. Like graduate, it shells out to a
# Node entry point because the bash CLI is sqlite-only (nsa33.4 guard).
# ---------------------------------------------------------------------------

cmd_downgrade() {
  local script_dir
  script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  PROJECT_ROOT="$PROJECT_ROOT" exec node "$script_dir/jt-downgrade" "$@"
}

cmd_help() {
  cat <<'HELP'
jt - JAT task CLI

Usage: jt <command> [options]

Commands:
  create  "title" [--title X] [--type X] [--priority N] [--description "..."]
                   [--labels "a,b"] [--deps "id1,id2"] [--assignee "X"]
                   [--files "glob1,glob2"] [--parent EPIC_ID] [--json]
  update  TASK_ID  [--status X] [--priority N] [--assignee X] [--title X]
                   [--description "..."] [--notes "..."] [--labels "a,b"]
                   [--files "glob1,glob2"] [--json]
  close   TASK_ID  [--reason "..."] [--json]
  delete  TASK_ID
  show    TASK_ID  [--json]
  list    [--status X] [--type X] [--limit N] [--json]
  ready   [--json] [--limit N]
  search  "query"  [--status X] [--type X] [--labels "a,b"]
                   [--updated-after DATE] [--limit N] [--json]
  dep     add TASK_ID DEPENDS_ON_ID
  dep     remove TASK_ID DEPENDS_ON_ID
  dep     tree TASK_ID [--reverse] [--json]
  dep     cycles
  data    tables | schema | query | exec | create | drop | columns
  bases   list | show | create | delete | attach | detach | render | search
  spawn   [TASK_ID] [--remote] [--local] [--model M] [--attach]
  agents  [--json] [--project X] [--all]  List active agents
  logs    <agent-name> [--remote] [--follow] [--lines N]  Stream agent output
  ssh     [agent-name]         Connect to VPS or attach to remote agent session
  audit   [--json] [--fix]    Check project context injection compliance
  graduate [PROJECT] --url <postgres-url> [--dry-run] [--yes] [--force]
                               Migrate project tasks from SQLite to Postgres
  downgrade [PROJECT] [--dry-run] [--yes] [--force] [--confirm PHRASE]
                               Reverse graduation: Postgres → local SQLite
  init    [--quiet]

Options:
  --version    Show version
  --help       Show this help

Status values: open, in_progress, waiting, blocked, submitted, accepted, deployed, closed, dev
Task types: bug, feature, task, epic, chore
HELP
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  create)    shift; cmd_create "$@" ;;
  update)    shift; cmd_update "$@" ;;
  close)     shift; cmd_close "$@" ;;
  delete)    shift; cmd_delete "$@" ;;
  show)      shift; cmd_show "$@" ;;
  list)      shift; cmd_list "$@" ;;
  ready)     shift; cmd_ready "$@" ;;
  search)    shift; cmd_search "$@" ;;
  dep)       shift; cmd_dep "$@" ;;
  data)      shift; cmd_data "$@" ;;
  bases)     shift; cmd_bases "$@" ;;
  spawn)     shift; cmd_spawn "$@" ;;
  agents)    shift; cmd_agents "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  ssh)       shift; cmd_ssh "$@" ;;
  audit)     shift; cmd_audit "$@" ;;
  graduate)  shift; cmd_graduate "$@" ;;
  downgrade) shift; cmd_downgrade "$@" ;;
  init)      shift; cmd_init "$@" ;;
  --version) echo "jt $VERSION" ;;
  --help|-h|help) cmd_help ;;
  "")        cmd_help ;;
  *)         die "Unknown command: $1. Run 'jt --help' for usage." ;;
esac

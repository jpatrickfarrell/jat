#!/usr/bin/env node

import { loadConfig, configPath } from './lib/config.js';
import Database from 'better-sqlite3';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const args = process.argv.slice(2);

if (args.includes('--help') || args.includes('-h')) {
  console.log(`jat-ingest-status - Show ingestion source status

USAGE:
    jat-ingest-status               Overview of all sources
    jat-ingest-status --source <id> Detailed stats for one source
    jat-ingest-status --json        Output as JSON
    jat-ingest-status --help        Show this help`);
  process.exit(0);
}

const sourceId = getArg('--source');
const jsonOutput = args.includes('--json');

let config;
try {
  config = loadConfig();
} catch (err) {
  console.error(`Config error: ${err.message}`);
  process.exit(1);
}

// Find tasks.db by walking up from cwd
function findTasksDb() {
  let dir = process.cwd();
  for (let i = 0; i < 10; i++) {
    const p = join(dir, '.jat', 'tasks.db');
    if (existsSync(p)) return p;
    const parent = join(dir, '..');
    if (parent === dir) break;
    dir = parent;
  }
  return null;
}

/**
 * Query per-source task counts from tasks.db.
 * @returns {Map<string, { total: number, lastCreated: string | null }>}
 */
function getSourceStats(dbPath) {
  const stats = new Map();
  if (!dbPath || !existsSync(dbPath)) return stats;
  let db;
  try {
    db = new Database(dbPath, { readonly: true });
    const rows = db.prepare(
      `SELECT source, COUNT(*) as total, MAX(created_at) as lastCreated
       FROM tasks
       WHERE source IS NOT NULL
       GROUP BY source`
    ).all();
    for (const row of rows) {
      stats.set(row.source, { total: row.total, lastCreated: row.lastCreated || null });
    }
  } catch (err) {
    // tasks.db may not have source column on old installs
  } finally {
    db?.close();
  }
  return stats;
}

/**
 * Get item count for a specific source.
 */
function getItemCount(dbPath, source) {
  if (!dbPath || !existsSync(dbPath)) return 0;
  let db;
  try {
    db = new Database(dbPath, { readonly: true });
    const row = db.prepare(
      'SELECT COUNT(*) as count FROM tasks WHERE source = ?'
    ).get(source);
    return row?.count || 0;
  } catch {
    return 0;
  } finally {
    db?.close();
  }
}

const dbPath = findTasksDb();
const statsMap = getSourceStats(dbPath);

if (sourceId) {
  showSourceDetail(sourceId);
} else {
  showOverview();
}

function showOverview() {
  const results = config.sources.map(source => {
    const stat = statsMap.get(source.type) || statsMap.get(source.id) || { total: 0, lastCreated: null };
    return {
      id: source.id,
      type: source.type,
      enabled: source.enabled !== false,
      project: source.project,
      totalItems: stat.total,
      lastIngested: stat.lastCreated,
      pollInterval: source.pollInterval || 60
    };
  });

  if (jsonOutput) {
    console.log(JSON.stringify(results, null, 2));
    return;
  }

  console.log(`Config: ${configPath()}`);
  console.log(`Sources: ${config.sources.length}`);
  console.log('');

  for (const r of results) {
    const status = !r.enabled ? 'disabled' : 'ok';
    const statusIcon = status === 'disabled' ? '-' : 'o';

    console.log(`[${statusIcon}] ${r.id} (${r.type}) -> ${r.project}`);
    console.log(`    Items: ${r.totalItems} | Poll interval: ${r.pollInterval}s`);
    if (r.lastIngested) {
      console.log(`    Last ingested: ${r.lastIngested}`);
    }
    console.log('');
  }
}

function showSourceDetail(id) {
  const source = config.sources.find(s => s.id === id);
  if (!source) {
    console.error(`Source not found: ${id}`);
    process.exit(1);
  }

  const count = getItemCount(dbPath, source.type || source.id);
  const stat = statsMap.get(source.type) || statsMap.get(source.id) || { total: count, lastCreated: null };

  if (jsonOutput) {
    console.log(JSON.stringify({ source, itemCount: count, lastCreated: stat.lastCreated }, null, 2));
    return;
  }

  console.log(`Source: ${source.id}`);
  console.log(`Type: ${source.type}`);
  console.log(`Project: ${source.project}`);
  console.log(`Enabled: ${source.enabled !== false}`);
  console.log(`Poll interval: ${source.pollInterval || 60}s`);
  console.log(`Total items ingested: ${count}`);
  if (stat.lastCreated) {
    console.log(`Last ingested: ${stat.lastCreated}`);
  }
}

function getArg(flag) {
  const idx = args.indexOf(flag);
  if (idx === -1) return null;
  return args[idx + 1] || null;
}

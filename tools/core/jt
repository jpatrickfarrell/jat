#!/bin/bash
# jt - JAT task CLI (replaces bd)
# Pure bash + sqlite3. No Node startup cost.
set -euo pipefail

VERSION="0.1.0"
DB_NAME=".jat/tasks.db"
DATA_DB_NAME=".jat/data.db"
BASES_DB_NAME=".jat/data.db"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() { echo "Error: $*" >&2; exit 1; }

# Find the project root (walk up looking for .jat/ or .git/)
find_project_root() {
  local dir="$PWD"
  local first_jat=""
  while [[ "$dir" != "/" ]]; do
    # A dir with both .jat and .git is the true project root
    if [[ -d "$dir/.jat" && -d "$dir/.git" ]]; then
      echo "$dir" && return 0
    fi
    # Remember the first .jat we find as fallback
    if [[ -d "$dir/.jat" && -z "$first_jat" ]]; then
      first_jat="$dir"
    fi
    # .git without .jat is also a valid root
    if [[ -d "$dir/.git" ]]; then
      echo "$dir" && return 0
    fi
    dir="$(dirname "$dir")"
  done
  # Fall back to first .jat found, or PWD
  echo "${first_jat:-$PWD}"
}

PROJECT_ROOT="$(find_project_root)"
DB="$PROJECT_ROOT/$DB_NAME"
DATA_DB="$PROJECT_ROOT/$DATA_DB_NAME"
BASES_DB="$PROJECT_ROOT/$BASES_DB_NAME"

# Resolve the configured JAT task backend for the current project.
# Reads ~/.config/jat/projects.json and matches by absolute path.
# Defaults to "sqlite" when the project isn't listed or has no backend field.
# Echoes: "sqlite" or "postgres".  Never fails — missing jq is treated as sqlite.
resolve_project_backend() {
  local config="$HOME/.config/jat/projects.json"
  [[ -f "$config" ]] || { echo "sqlite"; return; }
  command -v jq >/dev/null 2>&1 || { echo "sqlite"; return; }

  # Expand ~ in config paths at query time so absolute matching works.
  local backend
  backend="$(jq -r --arg root "$PROJECT_ROOT" --arg home "$HOME" '
    .projects // {} | to_entries[] |
    select((.value.path // "" | gsub("^~"; $home)) == $root) |
    (.value.backend // "sqlite")
  ' "$config" 2>/dev/null | head -n1)"

  [[ -n "$backend" ]] || backend="sqlite"
  echo "$backend"
}

# Guard: abort with a clear error if the current project is postgres-backed.
# The bash CLI is sqlite-only; postgres projects must use the IDE/Node code path.
require_sqlite_backend() {
  local backend
  backend="$(resolve_project_backend)"
  if [[ "$backend" != "sqlite" ]]; then
    die "Project '$PROJECT_ROOT' is configured with backend=$backend. The 'jt' bash CLI only supports sqlite. Use the JAT IDE or a Node entry point for postgres-backed projects."
  fi
}

# ---------------------------------------------------------------------------
# Postgres / IDE REST proxy helpers
# Used when backend=postgres; proxies jt commands to localhost IDE API.
# ---------------------------------------------------------------------------

# Resolve the JAT IDE port. The JAT IDE always runs on 3333.
# Projects have a "port" field for their own dev server, which is separate.
# We check for an explicit "jat_ide_port" override, otherwise use 3333.
resolve_ide_port() {
  local config="$HOME/.config/jat/projects.json"
  local override=""
  if [[ -f "$config" ]] && command -v jq >/dev/null 2>&1; then
    override="$(jq -r --arg root "$PROJECT_ROOT" --arg home "$HOME" '
      .projects // {} | to_entries[] |
      select((.value.path // "" | gsub("^~"; $home)) == $root) |
      (.value.jat_ide_port // "") | tostring
    ' "$config" 2>/dev/null | head -n1)"
  fi
  if [[ -n "$override" && "$override" != "null" && "$override" != "" ]]; then
    echo "$override"
  else
    echo "3333"
  fi
}

# Resolve the project key name from projects.json (used as ?project= param).
resolve_project_name() {
  local config="$HOME/.config/jat/projects.json"
  [[ -f "$config" ]] || { echo ""; return; }
  command -v jq >/dev/null 2>&1 || { echo ""; return; }
  jq -r --arg root "$PROJECT_ROOT" --arg home "$HOME" '
    .projects // {} | to_entries[] |
    select((.value.path // "" | gsub("^~"; $home)) == $root) |
    .key
  ' "$config" 2>/dev/null | head -n1
}

# Make a curl request to the IDE REST API.
# Usage: pg_curl GET /api/tasks/id
#        pg_curl PUT /api/tasks/id '{"status":"closed"}'
#        pg_curl POST /api/tasks/id/close '{"reason":"Done"}'
pg_curl() {
  local method="$1" path="$2" data="${3:-}"
  local port
  port="$(resolve_ide_port)"
  if [[ -z "$port" || "$port" == "null" ]]; then
    die "Cannot proxy to IDE: no port configured for this project in ~/.config/jat/projects.json"
  fi
  if [[ -n "$data" ]]; then
    curl -sf --max-time 10 -X "$method" "http://127.0.0.1:${port}${path}" \
      -H "Content-Type: application/json" --data "$data" 2>/dev/null
  else
    curl -sf --max-time 10 -X "$method" "http://127.0.0.1:${port}${path}" 2>/dev/null
  fi
}

# Assert IDE is running; die with a helpful message if not.
require_ide_reachable() {
  local port
  port="$(resolve_ide_port)"
  if [[ -z "$port" || "$port" == "null" ]]; then
    die "Project uses postgres backend but no IDE port is configured. Add 'port' to this project in ~/.config/jat/projects.json."
  fi
  if ! curl -sf --max-time 2 "http://127.0.0.1:${port}/" >/dev/null 2>&1; then
    die "Project uses postgres backend. Start the JAT IDE (run: jat) first — the API at localhost:${port} is not reachable."
  fi
}

# Return 0 (true) when the IDE is reachable, 1 (false) otherwise.
# Unlike require_ide_reachable, this never dies — it's for branching logic.
ide_is_reachable() {
  local port
  port="$(resolve_ide_port)"
  [[ -z "$port" || "$port" == "null" ]] && return 1
  curl -sf --max-time 2 "http://127.0.0.1:${port}/" >/dev/null 2>&1
}

# Resolve the path to the jt-pg-direct Node.js helper (lives alongside this script).
_jt_pg_direct() {
  local script_dir
  script_dir="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
  "${script_dir}/jt-pg-direct" "$@"
}

# Transform IDE API response (various formats) to a JSON array matching jt output.
# Handles: {task:{...}}, {tasks:[...]}, {success:true,task:{...}}, [{...}]
_pg_normalize_tasks() {
  python3 -c "
import sys, json
raw = json.load(sys.stdin)
if isinstance(raw, list):
    items = raw
elif isinstance(raw, dict):
    if 'task' in raw and isinstance(raw.get('task'), dict):
        items = [raw['task']]
    elif 'tasks' in raw:
        items = raw['tasks']
    else:
        items = [raw]
else:
    items = []
result = []
for t in items:
    if not t:
        continue
    for key in ('labels', 'dependencies', 'dependents'):
        val = t.get(key)
        if isinstance(val, str):
            try:
                t[key] = json.loads(val)
            except (json.JSONDecodeError, TypeError):
                t[key] = []
        elif val is None:
            t[key] = []
    if 'issue_type' not in t and 'type' in t:
        t['issue_type'] = t['type']
    result.append(t)
json.dump(result, sys.stdout, indent=2)
print()
"
}

# pg_show: print task from IDE API (mirrors cmd_show)
# Falls back to jt-pg-direct for a direct postgres query when the IDE is offline.
pg_show() {
  local task_id="$1" json_out="${2:-false}"
  local normalized

  if ide_is_reachable; then
    local response
    response="$(pg_curl GET "/api/tasks/${task_id}")" || die "Task not found: ${task_id}"
    if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
      die "Task not found: ${task_id}"
    fi
    normalized="$(echo "$response" | _pg_normalize_tasks)"
  else
    # IDE not running — query postgres directly via Node.js helper.
    normalized="$(_jt_pg_direct show "$task_id" "$PROJECT_ROOT")" \
      || die "Task not found: ${task_id} (IDE offline; direct postgres query failed)"
  fi

  if [[ "$json_out" == "true" ]]; then
    echo "$normalized"
  else
    echo "$normalized" | _pretty_print_task
  fi
}

# pg_update: update task via IDE API (mirrors cmd_update flags)
# Usage: pg_update TASK_ID [--status X] [--assignee X] [--files X] [--priority N]
#                          [--title X] [--description X] [--notes X] [--labels X] [--json]
pg_update() {
  local task_id="$1"
  shift
  local json_out=false
  local payload="{}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status)      payload="$(echo "$payload" | jq --arg v "$2" '. + {status: $v}')"; shift 2 ;;
      --priority)    payload="$(echo "$payload" | jq --argjson v "$2" '. + {priority: $v}')"; shift 2 ;;
      --title)       payload="$(echo "$payload" | jq --arg v "$2" '. + {title: $v}')"; shift 2 ;;
      --description) payload="$(echo "$payload" | jq --arg v "$2" '. + {description: $v}')"; shift 2 ;;
      --notes)       payload="$(echo "$payload" | jq --arg v "$2" '. + {notes: $v}')"; shift 2 ;;
      --assignee)    payload="$(echo "$payload" | jq --arg v "$2" '. + {assignee: $v}')"; shift 2 ;;
      --approver)    payload="$(echo "$payload" | jq --arg v "$2" '. + {approver: $v, requester: $v}')"; shift 2 ;;
      --creator)     payload="$(echo "$payload" | jq --arg v "$2" '. + {creator: $v}')"; shift 2 ;;
      --requester)   payload="$(echo "$payload" | jq --arg v "$2" '. + {requester: $v, approver: $v}')"; shift 2 ;;  # deprecated alias
      --files)       payload="$(echo "$payload" | jq --arg v "$2" '. + {reserved_files: $v}')"; shift 2 ;;
      --labels)      payload="$(echo "$payload" | jq --arg v "$2" '. + {labels: ($v | split(",") | map(ltrimstr(" ") | rtrimstr(" ")))}')"; shift 2 ;;
      --json)        json_out=true; shift ;;
      # warn on flags not supported via REST (--command, --agent-program, etc.)
      --command|--agent-program|--model|--schedule-cron|--next-run-at|--due-date)
        echo "Warning: $1 is not supported for postgres projects (skipped)" >&2; shift 2 ;;
      *) shift ;;
    esac
  done

  if ide_is_reachable; then
    local response
    response="$(pg_curl PUT "/api/tasks/${task_id}" "$payload")" || die "Failed to update task: ${task_id}"
    if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
      local err_msg
      err_msg="$(echo "$response" | jq -r '.error // .message // "unknown"')"
      die "Failed to update task ${task_id}: ${err_msg}"
    fi
    if $json_out; then
      echo "$response" | _pg_normalize_tasks
    else
      echo "Updated $task_id"
    fi
  else
    # IDE not running — write directly via Node.js helper.
    local result
    result="$(_jt_pg_direct update "$task_id" "$PROJECT_ROOT" "$payload")" \
      || die "Failed to update task ${task_id} (IDE offline; direct postgres query failed)"
    if $json_out; then
      echo "$result"
    else
      echo "Updated $task_id"
    fi
  fi
}

# pg_close: close task via IDE API (mirrors cmd_close)
pg_close() {
  local task_id="$1"
  shift
  local reason="" json_out=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) reason="$2"; shift 2 ;;
      --json)   json_out=true; shift ;;
      *)        shift ;;
    esac
  done

  require_ide_reachable
  local payload
  payload="$(jq -n --arg r "$reason" '{reason: $r}')"
  local response
  response="$(pg_curl POST "/api/tasks/${task_id}/close" "$payload")" || die "Failed to close task: ${task_id}"
  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    local err_msg
    err_msg="$(echo "$response" | jq -r '.error // .message // "unknown"')"
    die "Failed to close task ${task_id}: ${err_msg}"
  fi
  if $json_out; then
    echo "$response" | _pg_normalize_tasks
  else
    echo "Closed $task_id"
  fi
}

# pg_list: list tasks via IDE API (mirrors cmd_list)
pg_list() {
  local status="" type="" limit="" json_out=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) status="$2"; shift 2 ;;
      --type)   type="$2"; shift 2 ;;
      --limit)  limit="$2"; shift 2 ;;
      --json)   json_out=true; shift ;;
      *)        shift ;;
    esac
  done

  local project_name
  project_name="$(resolve_project_name)"
  [[ -n "$project_name" ]] || die "Could not determine project name from ~/.config/jat/projects.json"

  local params="project=${project_name}"
  [[ -n "$status" ]] && params="${params}&status=${status}"
  [[ -n "$limit" ]] && params="${params}&limit=${limit}"

  require_ide_reachable
  local response normalized
  response="$(pg_curl GET "/api/tasks?${params}")" || die "Failed to list tasks"
  normalized="$(echo "$response" | _pg_normalize_tasks)"

  if $json_out; then
    echo "$normalized"
  else
    if [[ "$(echo "$normalized" | jq 'length')" == "0" ]]; then
      echo "No tasks found."
    else
      echo "$normalized" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for t in data:
    labels = t.get('labels', [])
    lbl_str = (' [' + ', '.join(labels) + ']') if labels else ''
    assignee = (' @' + t['assignee']) if t.get('assignee') else ''
    print(f\"  [P{t['priority']}] {t['id']}: {t['title']}{lbl_str}{assignee} ({t['status']})\")
"
    fi
  fi
}

# pg_ready: return open tasks via IDE API (mirrors cmd_ready; no dep-filtering)
pg_ready() {
  local limit="" json_out=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)  json_out=true; shift ;;
      --limit) limit="$2"; shift 2 ;;
      *)       shift ;;
    esac
  done

  local project_name
  project_name="$(resolve_project_name)"
  [[ -n "$project_name" ]] || die "Could not determine project name from ~/.config/jat/projects.json"

  local params="project=${project_name}&status=open"
  [[ -n "$limit" ]] && params="${params}&limit=${limit}"

  require_ide_reachable
  local response normalized
  response="$(pg_curl GET "/api/tasks?${params}")" || die "Failed to fetch ready tasks"
  normalized="$(echo "$response" | _pg_normalize_tasks)"

  if $json_out; then
    echo "$normalized"
  else
    if [[ "$(echo "$normalized" | jq 'length')" == "0" ]]; then
      echo "No ready tasks."
    else
      echo "Ready tasks:"
      echo "$normalized" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for t in data:
    labels = t.get('labels', [])
    lbl_str = (' [' + ', '.join(labels) + ']') if labels else ''
    print(f\"  [P{t['priority']}] {t['id']}: {t['title']}{lbl_str}\")
"
    fi
  fi
}

# pg_search: search tasks via IDE API (mirrors cmd_search)
pg_search() {
  local query="" status="" type="" labels="" limit=50 json_out=false updated_after=""

  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    query="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)          json_out=true; shift ;;
      --limit)         limit="$2"; shift 2 ;;
      --status)        status="$2"; shift 2 ;;
      --type)          type="$2"; shift 2 ;;
      --labels)        labels="$2"; shift 2 ;;
      --updated-after) updated_after="$2"; shift 2 ;;
      *)               [[ -z "$query" ]] && query="$1"; shift ;;
    esac
  done

  [[ -n "$query" ]] || die "Usage: jt search \"query\" [--status X] [--type X] [--labels X] [--limit N] [--json]"

  local project_name
  project_name="$(resolve_project_name)"
  [[ -n "$project_name" ]] || die "Could not determine project name from ~/.config/jat/projects.json"

  local encoded_query
  encoded_query="$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")"
  local params="project=${project_name}&search=${encoded_query}&limit=${limit}"
  [[ -n "$status" ]] && params="${params}&status=${status}"

  require_ide_reachable
  local response normalized
  response="$(pg_curl GET "/api/tasks?${params}")" || die "Failed to search tasks"
  normalized="$(echo "$response" | _pg_normalize_tasks)"

  # Client-side filter by type (issue_type) if specified
  if [[ -n "$type" ]]; then
    normalized="$(echo "$normalized" | jq --arg t "$type" '[.[] | select(.issue_type == $t)]')"
  fi
  # Client-side filter by labels if specified (comma-separated, match any)
  if [[ -n "$labels" ]]; then
    normalized="$(echo "$normalized" | jq --arg l "$labels" '
      ($l | split(",") | map(ltrimstr(" ") | rtrimstr(" "))) as $wanted |
      [.[] | select(.labels != null and (.labels | any(. as $lbl | $wanted | any(. == $lbl))))]
    ')"
  fi

  if $json_out; then
    echo "$normalized"
  else
    if [[ "$(echo "$normalized" | jq 'length')" == "0" ]]; then
      echo "No tasks found matching: $query"
    else
      echo "$normalized" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for t in data:
    labels = t.get('labels', [])
    lbl_str = (' [' + ', '.join(labels) + ']') if labels else ''
    assignee = (' @' + t['assignee']) if t.get('assignee') else ''
    print(f\"  [P{t['priority']}] {t['id']}: {t['title']}{lbl_str}{assignee} ({t['status']})\")
"
    fi
  fi
}

# pg_create: create task via IDE API (mirrors cmd_create flags)
# Requires IDE to be running (no direct postgres write path).
pg_create() {
  local title="" description="" type="task" priority=2 labels="" deps="" assignee="" approver="" creator="" json_out=false parent_id="" reserved_files=""
  local command="" agent_program="" model="" schedule_cron="" next_run_at="" due_date=""

  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    title="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)          title="$2"; shift 2 ;;
      --type)           type="$2"; shift 2 ;;
      --priority)       priority="$2"; shift 2 ;;
      --description)    description="$2"; shift 2 ;;
      --labels)         labels="$2"; shift 2 ;;
      --deps)           deps="$2"; shift 2 ;;
      --assignee)       assignee="$2"; shift 2 ;;
      --approver)       approver="$2"; shift 2 ;;
      --creator)        creator="$2"; shift 2 ;;
      --requester)      approver="$2"; shift 2 ;;  # deprecated alias for --approver
      --files)          reserved_files="$2"; shift 2 ;;
      --parent)         parent_id="$2"; shift 2 ;;
      --command)        command="$2"; shift 2 ;;
      --agent-program)  agent_program="$2"; shift 2 ;;
      --model)          model="$2"; shift 2 ;;
      --schedule-cron)  schedule_cron="$2"; shift 2 ;;
      --next-run-at)    next_run_at="$2"; shift 2 ;;
      --due-date)       due_date="$2"; shift 2 ;;
      --json)           json_out=true; shift ;;
      # silently skip flags not supported via REST
      --id|--source|--source-item-id|--metadata) shift 2 ;;
      *)                [[ -z "$title" ]] && title="$1"; shift ;;
    esac
  done

  [[ -n "$title" ]] || die "Usage: jt create \"title\" [--type X] [--priority N] [--description \"...\"] [--labels \"a,b\"] [--deps \"id1,id2\"] [--assignee X] [--approver X] [--creator X] [--files \"globs\"] [--parent EPIC_ID] [--json]"

  local project_name
  project_name="$(resolve_project_name)"
  [[ -n "$project_name" ]] || die "Could not determine project name from ~/.config/jat/projects.json"

  require_ide_reachable

  # Build payload
  local payload
  payload="$(jq -n \
    --arg project "$project_name" \
    --arg title "$title" \
    --arg description "$description" \
    --arg type "$type" \
    --argjson priority "$priority" \
    '{project: $project, title: $title, description: $description, type: $type, priority: $priority}')"

  if [[ -n "$labels" ]]; then
    payload="$(echo "$payload" | jq --arg v "$labels" '. + {labels: ($v | split(",") | map(ltrimstr(" ") | rtrimstr(" ")) | map(select(length > 0)))}')"
  fi
  if [[ -n "$deps" ]]; then
    payload="$(echo "$payload" | jq --arg v "$deps" '. + {deps: ($v | split(",") | map(ltrimstr(" ") | rtrimstr(" ")) | map(select(length > 0)))}')"
  fi
  [[ -n "$assignee" ]]        && payload="$(echo "$payload" | jq --arg v "$assignee" '. + {assignee: $v}')"
  # Postgres backend migration is tracked separately (jat-9e5tc.1/.3). Until
  # that lands, send `requester` for back-compat with the current API contract.
  [[ -n "$approver" ]]        && payload="$(echo "$payload" | jq --arg v "$approver" '. + {requester: $v, approver: $v}')"
  [[ -n "$creator" ]]         && payload="$(echo "$payload" | jq --arg v "$creator" '. + {creator: $v}')"
  [[ -n "$reserved_files" ]]  && payload="$(echo "$payload" | jq --arg v "$reserved_files" '. + {reserved_files: $v}')"
  [[ -n "$parent_id" ]]       && payload="$(echo "$payload" | jq --arg v "$parent_id" '. + {parent_id: $v}')"
  [[ -n "$command" ]]         && payload="$(echo "$payload" | jq --arg v "$command" '. + {command: $v}')"
  [[ -n "$agent_program" ]]   && payload="$(echo "$payload" | jq --arg v "$agent_program" '. + {agent_program: $v}')"
  [[ -n "$model" ]]           && payload="$(echo "$payload" | jq --arg v "$model" '. + {model: $v}')"
  [[ -n "$schedule_cron" ]]   && payload="$(echo "$payload" | jq --arg v "$schedule_cron" '. + {schedule_cron: $v}')"
  [[ -n "$next_run_at" ]]     && payload="$(echo "$payload" | jq --arg v "$next_run_at" '. + {next_run_at: $v}')"
  [[ -n "$due_date" ]]        && payload="$(echo "$payload" | jq --arg v "$due_date" '. + {due_date: $v}')"

  local response
  response="$(pg_curl POST "/api/tasks" "$payload")" || die "Failed to create task"
  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    local err_msg
    err_msg="$(echo "$response" | jq -r '.message // .error // "unknown"')"
    die "Failed to create task: ${err_msg}"
  fi

  local new_id new_title
  new_id="$(echo "$response" | jq -r '.task.id // .id // ""')"
  new_title="$(echo "$response" | jq -r '.task.title // .title // ""')"

  if $json_out; then
    echo "$response" | _pg_normalize_tasks
  else
    echo "Created ${new_id}: ${new_title}"
  fi
}

# pg_delete: delete task via IDE API (mirrors cmd_delete)
pg_delete() {
  local task_id="$1"
  [[ -n "$task_id" ]] || die "Usage: jt delete TASK_ID"
  require_ide_reachable
  local response
  response="$(pg_curl DELETE "/api/tasks/${task_id}")" || die "Failed to delete task: ${task_id}"
  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    local err_msg
    err_msg="$(echo "$response" | jq -r '.error // .message // "unknown"')"
    die "Failed to delete task ${task_id}: ${err_msg}"
  fi
  echo "Deleted $task_id"
}

# ---------------------------------------------------------------------------
# Knowledge bases — postgres proxy helpers (mirror cmd_bases_*)
# Used when backend=postgres; proxies through localhost IDE REST API.
# Endpoints used:
#   GET    /api/bases?project=X[&alwaysInjectOnly=true]   list
#   GET    /api/bases/{id}?project=X                       show
#   POST   /api/bases                                      create  (body: {project, name, ...})
#   DELETE /api/bases/{id}?project=X                       delete
#   POST   /api/bases/{baseId}/attach                       attach  (body: {project, taskId})
#   DELETE /api/bases/{baseId}/attach                       detach  (body: {project, taskId})
#   GET    /api/bases/search?project=X&q=Q&limit=N         search
#   POST   /api/bases/{id}/render                          render  (body: {project})
# ---------------------------------------------------------------------------

# Resolve project name with --project override fallback to projects.json key.
_pg_project_or_die() {
  local explicit="${1:-}"
  if [[ -n "$explicit" ]]; then
    echo "$explicit"
    return
  fi
  local name
  name="$(resolve_project_name)"
  [[ -n "$name" ]] || die "Could not determine project name from ~/.config/jat/projects.json"
  echo "$name"
}

# URL-encode a string for use in query params.
_pg_urlencode() {
  python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"
}

# Surface IDE error JSON cleanly. Returns 0 if response is not an error.
_pg_check_err() {
  local response="$1" context="$2"
  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    local err_msg
    err_msg="$(echo "$response" | jq -r '.error // .message // "unknown"')"
    die "${context}: ${err_msg}"
  fi
}

# Print bases list in the same human format as cmd_bases_list.
_pg_print_bases_list() {
  python3 -c "
import sys, json
data = json.load(sys.stdin)
if not data:
    print('No knowledge bases. Create one with: jt bases create --name \"Name\" --type manual --content \"...\"')
    sys.exit(0)
for b in data:
    inject = ' [always-inject]' if b.get('always_inject') else ''
    tokens = f' ~{b[\"token_estimate\"]}tok' if b.get('token_estimate') else ''
    desc = b.get('description') or ''
    if desc and len(desc) > 40:
        desc = desc[:37] + '...'
    desc_str = f' - {desc}' if desc else ''
    cfg = b.get('source_config') or {}
    if isinstance(cfg, str):
        try: cfg = json.loads(cfg)
        except Exception: cfg = {}
    src_type = b.get('source_type') or cfg.get('_migrated_source_type') or 'manual'
    print(f'  {b[\"id\"]}  [{src_type}] {b[\"name\"]}{inject}{tokens}{desc_str}')
"
}


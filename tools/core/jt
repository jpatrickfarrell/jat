cmd_bases_render() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_render "$@"
    return
  fi
  require_bases_db
  local id="${1:-}"
  [[ -n "$id" ]] || die "Usage: jt bases render ID"

  local result
  result="$(sql_bases_json "SELECT * FROM bases WHERE id = '$(sql_escape "$id")';")"
  [[ "$result" != "[]" ]] || die "Base not found: $id"

  # Extract source_type, content, and context_query from blocks/source_config JSON
  local source_type content context_query
  source_type="$(echo "$result" | python3 -c "
import sys, json
b = json.load(sys.stdin)[0]
blocks = json.loads(b.get('blocks') or '[]')
config = json.loads(b.get('source_config') or '{}')
st = config.get('_migrated_source_type', 'manual')
if not st or st == 'manual':
    for bl in blocks:
        if bl.get('type') == 'table_view':
            st = 'data_table'
            break
print(st)
")"
  content="$(echo "$result" | python3 -c "
import sys, json
b = json.load(sys.stdin)[0]
blocks = json.loads(b.get('blocks') or '[]')
text_parts = [bl.get('content','') for bl in blocks if bl.get('type') == 'text']
print('\n\n'.join(text_parts))
")"
  context_query="$(echo "$result" | python3 -c "
import sys, json
b = json.load(sys.stdin)[0]
blocks = json.loads(b.get('blocks') or '[]')
config = json.loads(b.get('source_config') or '{}')
cq = config.get('context_query', '')
if not cq:
    for bl in blocks:
        if bl.get('type') == 'table_view' and bl.get('query'):
            cq = bl['query']
            break
print(cq)
")"

  case "$source_type" in
    manual|conversation|external)
      echo "$content"
      ;;
    data_table)
      if [[ -z "$context_query" ]]; then
        if [[ -n "$content" ]]; then
          echo "$content"
        else
          echo "(no context query defined)"
        fi
        return
      fi
      if [[ ! -f "$DATA_DB" ]]; then
        echo "(data.db not found)"
        return
      fi
      # Safety: only allow SELECT
      if ! echo "$context_query" | grep -qiE '^\s*SELECT\b'; then
        echo "(context_query must be a SELECT statement)"
        return
      fi
      # Auto-add LIMIT if missing
      local sql="$context_query"
      if ! echo "$sql" | grep -qiE '\bLIMIT\b'; then
        sql="$(echo "$sql" | sed 's/;*\s*$/ LIMIT 100/')"
      fi
      local rows
      rows="$(sql_data_json "$sql" 2>/dev/null)" || { echo "(query error)"; return; }
      if [[ "$rows" == "[]" || -z "$rows" ]]; then
        echo "(no results)"
      else
        echo "$rows" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if not data:
    print('(no results)')
    sys.exit()
cols = list(data[0].keys())
print('| ' + ' | '.join(cols) + ' |')
print('| ' + ' | '.join(['---'] * len(cols)) + ' |')
for row in data:
    print('| ' + ' | '.join(str(row.get(c, '')) for c in cols) + ' |')
"
      fi
      ;;
    *)
      echo "$content"
      ;;
  esac
}

cmd_bases_search() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_search "$@"
    return
  fi
  require_bases_db
  local query="" limit=20 json_out=false

  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    query="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) limit="$2"; shift 2 ;;
      --json)  json_out=true; shift ;;
      *)       shift ;;
    esac
  done

  [[ -n "$query" ]] || die "Usage: jt bases search \"query\" [--limit N] [--json]"

  local fts_query
  fts_query="$(escape_fts_query "$query")"

  local result
  result="$(sql_bases_json "SELECT b.*, rank FROM bases_fts fts JOIN bases b ON b.rowid = fts.rowid WHERE bases_fts MATCH '$(sql_escape "$fts_query")' ORDER BY rank LIMIT $limit;" 2>/dev/null)" || result="[]"

  if $json_out; then
    echo "$result"
  else
    if [[ "$result" == "[]" ]]; then
      echo "No matches for: $query"
    else
      echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for b in data:
    desc = b.get('description') or ''
    if desc and len(desc) > 40:
        desc = desc[:37] + '...'
    desc_str = f' - {desc}' if desc else ''
    # Infer source_type from source_config and blocks
    config = json.loads(b.get('source_config') or '{}')
    blocks = json.loads(b.get('blocks') or '[]')
    st = config.get('_migrated_source_type', 'manual')
    if not st or st == 'manual':
        for bl in blocks:
            if bl.get('type') == 'table_view':
                st = 'data_table'
                break
    print(f'  {b[\"id\"]}  [{st}] {b[\"name\"]}{desc_str}')
"
    fi
  fi
}


# ---------------------------------------------------------------------------
# One-time migration: SQLite data + bases  →  JAT IDE REST  →  Supabase
# ---------------------------------------------------------------------------

# Issue a JSON request to the IDE and emit the response body on stdout.
# Exit 0 on HTTP 2xx, non-zero otherwise.  Unlike pg_curl this returns the
# response body even on error so migration failures can be reported.
_migrate_ide_request() {
  local method="$1" path="$2" data="${3:-}"
  local port out status body
  port="$(resolve_ide_port)"
  if [[ -n "$data" ]]; then
    out="$(curl -s --max-time 60 \
      -w $'\n__HTTP_STATUS__:%{http_code}' \
      -X "$method" "http://127.0.0.1:${port}${path}" \
      -H "Content-Type: application/json" --data "$data" 2>/dev/null || true)"
  else
    out="$(curl -s --max-time 30 \
      -w $'\n__HTTP_STATUS__:%{http_code}' \
      -X "$method" "http://127.0.0.1:${port}${path}" 2>/dev/null || true)"
  fi
  status="$(printf '%s' "$out" | awk -F'__HTTP_STATUS__:' '/__HTTP_STATUS__:/ {print $2}' | tail -1)"
  body="$(printf '%s' "$out" | sed '/__HTTP_STATUS__:/d')"
  printf '%s' "$body"
  [[ "$status" =~ ^2[0-9][0-9]$ ]]
}

cmd_data_migrate_to_postgres() {
  local dry_run=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)      dry_run=true; shift ;;
      --help|-h)      _cmd_data_migrate_help; return ;;
      *)              shift ;;
    esac
  done

  # Pre-flight: IDE reachable
  require_ide_reachable

  # Pre-flight: project must be configured with backend=postgres, otherwise
  # the IDE will just write to its own local SQLite and the migration is a no-op.
  local backend
  backend="$(resolve_project_backend)"
  if [[ "$backend" != "postgres" ]]; then
    die "This project is configured with backend=$backend. Migration requires backend=postgres (run 'jat graduate' first or edit ~/.config/jat/projects.json)."
  fi

  # Pre-flight: at least one source file must exist
  if [[ ! -f "$DATA_DB" && ! -f "$BASES_DB" ]]; then
    die "Nothing to migrate: neither $DATA_DB nor $BASES_DB exist"
  fi

  local project port
  project="$(resolve_project_name)"
  [[ -n "$project" ]] || project="$(basename "$PROJECT_ROOT")"
  port="$(resolve_ide_port)"

  local tables_created=0 tables_skipped=0 tables_failed=0
  local rows_inserted=0
  local bases_created=0 bases_skipped=0 bases_failed=0

  echo "Migrating '$project' → remote postgres (via IDE at 127.0.0.1:$port)"
  $dry_run && echo "  (dry-run: no changes will be made)"
  echo ""

  # --------------- Data tables ---------------
  if [[ -f "$DATA_DB" ]]; then
    # Confirm _tables exists (older data.db files may not)
    local has_meta
    has_meta="$(sqlite3 "$DATA_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='_tables';" 2>/dev/null || true)"

    if [[ -z "$has_meta" ]]; then
      echo "No _tables registry in $DATA_DB — skipping data-tables phase"
    else
      # Fetch remote table names for idempotency
      local remote_tables_resp remote_names
      remote_tables_resp="$(_migrate_ide_request GET "/api/data/tables?project=$project" 2>/dev/null || echo '{"tables":[]}')"
      remote_names="$(printf '%s' "$remote_tables_resp" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    for t in d.get('tables') or []:
        n = t.get('name') if isinstance(t, dict) else t
        if n: print(n)
except Exception:
    pass
" 2>/dev/null || true)"

      local user_tables
      user_tables="$(sqlite3 "$DATA_DB" "SELECT name FROM _tables ORDER BY name;" 2>/dev/null || true)"

      if [[ -z "$user_tables" ]]; then
        echo "No user tables registered in _tables"
      fi

      while IFS= read -r tbl; do
        [[ -n "$tbl" ]] || continue

        local remote_exists=false
        if printf '%s\n' "$remote_names" | grep -qxF "$tbl"; then
          remote_exists=true
        fi

        # Build columns payload (name, type, semanticType from _columns if present)
        local cols_json
        cols_json="$(DATA_DB="$DATA_DB" TBL="$tbl" python3 -c "
import os, sys, sqlite3, json
db = sqlite3.connect(os.environ['DATA_DB']); db.row_factory = sqlite3.Row
tbl = os.environ['TBL']
cols = [{'name': r['name'], 'type': (r['type'] or 'TEXT').upper()}
        for r in db.execute(f'PRAGMA table_info(\"{tbl}\")').fetchall()]
if db.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name='_columns'\").fetchone():
    sem = {r['column_name']: (r['semantic_type'], r['config'])
           for r in db.execute('SELECT column_name, semantic_type, config FROM _columns WHERE table_name = ?', (tbl,)).fetchall()}
    for c in cols:
        if c['name'] in sem:
            s, cfg = sem[c['name']]
            if s: c['semanticType'] = s
            if cfg and cfg != '{}':
                try: c['config'] = json.loads(cfg)
                except Exception: pass
print(json.dumps(cols))
" 2>/dev/null)"

        local n_cols
        n_cols="$(printf '%s' "$cols_json" | python3 -c 'import sys,json;print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0)"
        if [[ "$n_cols" -eq 0 ]]; then
          echo "  table '$tbl': no columns detected — skipping" >&2
          tables_failed=$((tables_failed + 1))
          continue
        fi

        # Create remote table if it doesn't already exist
        if $remote_exists; then
          echo "  table '$tbl': already exists on remote — skipping create"
          tables_skipped=$((tables_skipped + 1))
        else
          if $dry_run; then
            echo "  [dry-run] would create table '$tbl' ($n_cols cols)"
            tables_created=$((tables_created + 1))
          else
            local create_payload
            create_payload="$(COLS="$cols_json" PROJECT="$project" NAME="$tbl" python3 -c "
import os, json
print(json.dumps({'project': os.environ['PROJECT'], 'name': os.environ['NAME'], 'columns': json.loads(os.environ['COLS'])}))
")"
            local resp
            if resp="$(_migrate_ide_request POST "/api/data/tables" "$create_payload")"; then
              echo "  table '$tbl': created"
              tables_created=$((tables_created + 1))
            else
              local err
              err="$(printf '%s' "$resp" | python3 -c "import sys,json
try: print(json.load(sys.stdin).get('error') or '(unknown)')
except: print('(no response)')" 2>/dev/null)"
              echo "  table '$tbl': FAILED — $err" >&2
              tables_failed=$((tables_failed + 1))
              continue
            fi
          fi
        fi

        # Rows: insert via POST /api/data/tables/{tbl}/rows (takes plain JSON,
        # no SQL parser constraints).  When the table already existed on the
        # remote, first check its row count — skip if non-empty (idempotent),
        # insert if empty (recovery from a prior partial failure).
        local local_count
        local_count="$(sqlite3 "$DATA_DB" "SELECT COUNT(*) FROM \"$tbl\";" 2>/dev/null || echo 0)"
        [[ "$local_count" -gt 0 ]] || continue

        if $dry_run; then
          echo "    [dry-run] would insert $local_count row(s)"
          rows_inserted=$((rows_inserted + local_count))
          continue
        fi

        if $remote_exists; then
          local remote_count_resp remote_count=0
          remote_count_resp="$(_migrate_ide_request GET "/api/data/tables/$tbl/rows?project=$project&limit=1&offset=0" 2>/dev/null || echo '{}')"
          remote_count="$(printf '%s' "$remote_count_resp" | python3 -c "
import sys, json
try: print(json.load(sys.stdin).get('total') or 0)
except: print(0)" 2>/dev/null || echo 0)"
          if [[ "$remote_count" -gt 0 ]]; then
            echo "    remote already has $remote_count row(s) — skipping row insert"
            continue
          fi
        fi

        # Emit local rows as a JSON array of column→value dicts
        local rows_json
        rows_json="$(DATA_DB="$DATA_DB" TBL="$tbl" python3 -c "
import os, sys, sqlite3, json, base64
db = sqlite3.connect(os.environ['DATA_DB']); db.row_factory = sqlite3.Row
tbl = os.environ['TBL']
cur = db.execute(f'SELECT * FROM \"{tbl}\"')
all_cols = [c[0] for c in cur.description]
cols = [c for c in all_cols if c != 'rowid']
out = []
for row in cur:
    d = {}
    for c in cols:
        v = row[c]
        if isinstance(v, (bytes, bytearray)):
            v = base64.b64encode(v).decode('ascii')
        d[c] = v
    out.append(d)
print(json.dumps(out))
")"

        local n_rows inserted=0 row_failures=0
        n_rows="$(printf '%s' "$rows_json" | python3 -c 'import sys,json;print(len(json.load(sys.stdin)))')"
        local i=0
        while [[ $i -lt $n_rows ]]; do
          local row_payload
          row_payload="$(ROWS="$rows_json" I="$i" PROJECT="$project" python3 -c "
import os, json
row = json.loads(os.environ['ROWS'])[int(os.environ['I'])]
row['project'] = os.environ['PROJECT']
print(json.dumps(row))
")"
          local resp
          if resp="$(_migrate_ide_request POST "/api/data/tables/$tbl/rows" "$row_payload")"; then
            inserted=$((inserted + 1))
          else
            row_failures=$((row_failures + 1))
            if [[ $row_failures -le 3 ]]; then
              local err
              err="$(printf '%s' "$resp" | python3 -c "import sys,json
try: print(json.load(sys.stdin).get('error') or '(unknown)')
except: print('(no response)')" 2>/dev/null)"
              echo "    row $((i + 1)) FAILED: $err" >&2
            fi
          fi
          i=$((i + 1))
        done
        if [[ $row_failures -gt 0 ]]; then
          echo "    inserted $inserted / $n_rows row(s) — $row_failures failed" >&2
        else
          echo "    inserted $inserted row(s)"
        fi
        rows_inserted=$((rows_inserted + inserted))
      done <<< "$user_tables"
    fi
  else
    echo "No $DATA_DB — skipping data-tables phase"
  fi

  echo ""

  # --------------- Bases ---------------
  # Bases may live in data.db (current convention), in $BASES_DB (config var),
  # and/or in the historical .jat/bases.db file.  Union everything by id;
  # data.db wins on conflict because it is the current source of truth.
  local bases_sources=() _legacy_bases_db="$PROJECT_ROOT/.jat/bases.db"
  [[ -f "$DATA_DB" ]] && bases_sources+=("$DATA_DB")
  if [[ -f "$BASES_DB" && "$BASES_DB" != "$DATA_DB" ]]; then
    bases_sources+=("$BASES_DB")
  fi
  if [[ -f "$_legacy_bases_db" && "$_legacy_bases_db" != "$DATA_DB" && "$_legacy_bases_db" != "$BASES_DB" ]]; then
    bases_sources+=("$_legacy_bases_db")
  fi

  if [[ ${#bases_sources[@]} -eq 0 ]]; then
    echo "No base sources to migrate"
  else
    # Collect bases from all sources, union by id (first source wins)
    local all_bases_json
    all_bases_json="$(SOURCES="${bases_sources[*]}" python3 -c "
import os, sys, sqlite3, json
paths = os.environ['SOURCES'].split()
seen = {}
for p in paths:
    try:
        db = sqlite3.connect(p); db.row_factory = sqlite3.Row
        if not db.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name='bases'\").fetchone():
            db.close(); continue
        for row in db.execute('SELECT * FROM bases').fetchall():
            d = dict(row)
            if d.get('id') and d['id'] not in seen:
                seen[d['id']] = d
        db.close()
    except Exception:
        pass
print(json.dumps(list(seen.values())))
")"

    local total_bases
    total_bases="$(printf '%s' "$all_bases_json" | python3 -c 'import sys,json;print(len(json.load(sys.stdin)))')"

    if [[ "$total_bases" -eq 0 ]]; then
      echo "No bases found in ${bases_sources[*]}"
    else
      echo "Found $total_bases local base(s) to consider"

      # Fetch remote base names for idempotency
      local remote_bases_resp remote_base_names
      remote_bases_resp="$(_migrate_ide_request GET "/api/bases?project=$project&includeSystem=false&includeGlobal=false" 2>/dev/null || echo '{"bases":[]}')"
      remote_base_names="$(printf '%s' "$remote_bases_resp" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    for b in d.get('bases') or []:
        n = b.get('name')
        if n: print(n)
except Exception:
    pass
" 2>/dev/null || true)"

      local idx=0
      while [[ $idx -lt $total_bases ]]; do
        local name payload
        name="$(ALL="$all_bases_json" IDX="$idx" python3 -c "
import os, json
print(json.loads(os.environ['ALL'])[int(os.environ['IDX'])].get('name') or '')
")"

        if [[ -z "$name" ]]; then
          echo "  base #$((idx + 1)) has no name — skipping" >&2
          bases_failed=$((bases_failed + 1))
          idx=$((idx + 1))
          continue
        fi

        if printf '%s\n' "$remote_base_names" | grep -qxF "$name"; then
          echo "  base '$name' already exists on remote — skipping"
          bases_skipped=$((bases_skipped + 1))
          idx=$((idx + 1))
          continue
        fi

        payload="$(ALL="$all_bases_json" IDX="$idx" PROJECT="$project" python3 -c "
import os, json
base = json.loads(os.environ['ALL'])[int(os.environ['IDX'])]
body = {
    'project': os.environ['PROJECT'],
    'name': base.get('name'),
    'description': base.get('description'),
    'always_inject': bool(base.get('always_inject', 0)),
}
if base.get('token_estimate') is not None:
    body['token_estimate'] = base['token_estimate']
blocks = base.get('blocks') or '[]'
if isinstance(blocks, str):
    try: blocks = json.loads(blocks)
    except Exception: blocks = []
if blocks:
    body['blocks'] = blocks
cfg = base.get('source_config') or '{}'
if isinstance(cfg, str):
    try: cfg = json.loads(cfg)
    except Exception: cfg = {}
if cfg:
    body['source_config'] = cfg
    if cfg.get('_migrated_source_type'):
        body['source_type'] = cfg['_migrated_source_type']
    if cfg.get('context_query'):
        body['context_query'] = cfg['context_query']
print(json.dumps(body))
")"

        if $dry_run; then
          echo "  [dry-run] would create base '$name'"
          bases_created=$((bases_created + 1))
        else
          local resp
          if resp="$(_migrate_ide_request POST "/api/bases" "$payload")"; then
            echo "  base '$name': created"
            bases_created=$((bases_created + 1))
          else
            local err
            err="$(printf '%s' "$resp" | python3 -c "import sys,json
try: print(json.load(sys.stdin).get('error') or '(unknown)')
except: print('(no response)')" 2>/dev/null)"
            echo "  base '$name': FAILED — $err" >&2
            bases_failed=$((bases_failed + 1))
          fi
        fi
        idx=$((idx + 1))
      done
    fi
  fi

  echo ""
  echo "Migration summary:"
  echo "  Tables: $tables_created created, $tables_skipped already-existed, $tables_failed failed"
  echo "  Rows:   $rows_inserted inserted"
  echo "  Bases:  $bases_created created, $bases_skipped already-existed, $bases_failed failed"
  $dry_run && echo "  (dry-run — no changes were actually made)"

  if [[ $tables_failed -gt 0 || $bases_failed -gt 0 ]]; then
    return 2
  fi
}

_cmd_data_migrate_help() {
  cat <<'HELP'
jt data migrate-to-postgres - One-time migration from SQLite to Supabase

Reads the local .jat/data.db (user tables + bases) and .jat/bases.db (legacy
bases location) and posts every table + row + base to the JAT IDE REST API.
The IDE in turn writes to Supabase for postgres-backed projects.

Usage: jt data migrate-to-postgres [--dry-run]

Options:
  --dry-run     Print what would be migrated without making any changes

Requirements:
  - The JAT IDE must be running (run: jat)
  - The project must be configured with backend=postgres in ~/.config/jat/projects.json
    (otherwise the IDE writes to its own local SQLite and the migration is a no-op)

Idempotency:
  - Tables that already exist on the remote are skipped (no row re-insert)
  - Bases that already exist on the remote (matched by name) are skipped
  - Safe to re-run after a partial failure

Exit codes:
  0  success — everything migrated or already present
  1  pre-flight failure (IDE offline, wrong backend, missing DB)
  2  partial failure — some tables or bases failed to migrate
HELP
}

# ---------------------------------------------------------------------------
# Knowledge Bases
# ---------------------------------------------------------------------------

BASES_SCHEMA='
CREATE TABLE IF NOT EXISTS bases (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    project TEXT NOT NULL,
    blocks TEXT DEFAULT '"'"'[]'"'"',
    description TEXT,
    always_inject INTEGER NOT NULL DEFAULT 0,
    token_estimate INTEGER,
    source_config TEXT DEFAULT '"'"'{}'"'"',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS task_bases (
    task_id TEXT NOT NULL,
    base_id TEXT NOT NULL,
    attached_at TEXT NOT NULL,
    attached_by TEXT,
    PRIMARY KEY (task_id, base_id),
    FOREIGN KEY (base_id) REFERENCES bases(id) ON DELETE CASCADE
);
CREATE TABLE IF NOT EXISTS task_tables (
    task_id TEXT NOT NULL,
    table_name TEXT NOT NULL,
    project TEXT NOT NULL,
    context_query TEXT,
    attached_at TEXT NOT NULL,
    attached_by TEXT,
    PRIMARY KEY (task_id, table_name, project)
);
CREATE VIRTUAL TABLE IF NOT EXISTS bases_fts USING fts5(
    name, description,
    content='"'"'bases'"'"', content_rowid='"'"'rowid'"'"'
);
CREATE TRIGGER IF NOT EXISTS bases_fts_ai AFTER INSERT ON bases BEGIN
    INSERT INTO bases_fts(rowid, name, description)
    VALUES (new.rowid, new.name, new.description);
END;
CREATE TRIGGER IF NOT EXISTS bases_fts_ad AFTER DELETE ON bases BEGIN
    INSERT INTO bases_fts(bases_fts, rowid, name, description)
    VALUES ('"'"'delete'"'"', old.rowid, old.name, old.description);
END;
CREATE TRIGGER IF NOT EXISTS bases_fts_au AFTER UPDATE ON bases BEGIN
    INSERT INTO bases_fts(bases_fts, rowid, name, description)
    VALUES ('"'"'delete'"'"', old.rowid, old.name, old.description);
    INSERT INTO bases_fts(rowid, name, description)
    VALUES (new.rowid, new.name, new.description);
END;
'

# Generate 8-char hex ID for bases
gen_base_id() {
  od -An -tx1 -N4 /dev/urandom | tr -d ' \n'
}

# Run a read-only query against bases.db, output JSON array
sql_bases_json() {
  local out
  out="$(sqlite3 -json "$BASES_DB" "$1")"
  if [[ -z "$out" ]]; then
    echo "[]"
  else
    echo "$out"
  fi
}

# Run a write query against bases.db
sql_bases_exec() {
  sqlite3 "$BASES_DB" "PRAGMA foreign_keys=ON; $1"
}

# Ensure bases table exists in data.db, creating if needed
require_bases_db() {
  if [[ ! -f "$BASES_DB" ]]; then
    local jat_dir="$PROJECT_ROOT/.jat"
    mkdir -p "$jat_dir"
    sqlite3 "$BASES_DB" "PRAGMA journal_mode=WAL; $BASES_SCHEMA"
  else
    # Check if bases table exists (may have _canvas_pages from pre-migration)
    local has_bases
    has_bases="$(sqlite3 "$BASES_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='bases';" 2>/dev/null)"
    if [[ -z "$has_bases" ]]; then
      sqlite3 "$BASES_DB" "PRAGMA journal_mode=WAL; $BASES_SCHEMA"
    fi
  fi
}

# Validate source_type
validate_source_type() {
  case "$1" in
    manual|data_table|conversation|external) ;;
    *) die "Invalid source type: $1. Must be one of: manual, data_table, conversation, external" ;;
  esac
}

cmd_bases() {
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || { cmd_bases_help; return; }
  shift

  case "$subcmd" in
    list)    cmd_bases_list "$@" ;;
    show)    cmd_bases_show "$@" ;;
    create)  cmd_bases_create "$@" ;;
    delete)  cmd_bases_delete "$@" ;;
    attach)  cmd_bases_attach "$@" ;;
    detach)  cmd_bases_detach "$@" ;;
    render)  cmd_bases_render "$@" ;;
    search)  cmd_bases_search "$@" ;;
    help|--help|-h) cmd_bases_help ;;
    *)       die "Unknown bases subcommand: $subcmd. Run 'jt bases help' for usage." ;;
  esac
}

cmd_bases_list() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_list "$@"
    return
  fi
  require_bases_db
  local json_out=false always_inject=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)           json_out=true; shift ;;
      --always-inject)  always_inject=true; shift ;;
      *) shift ;;
    esac
  done

  local where=""
  if $always_inject; then
    where="WHERE always_inject = 1"
  fi

  local result
  result="$(sql_bases_json "SELECT * FROM bases $where ORDER BY name;")"

  if $json_out; then
    echo "$result"
  else
    if [[ "$result" == "[]" ]]; then
      echo "No knowledge bases. Create one with: jt bases create --name \"Name\" --type manual --content \"...\""
    else
      echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for b in data:
    inject = ' [always-inject]' if b.get('always_inject', 0) == 1 else ''
    tokens = f' ~{b[\"token_estimate\"]}tok' if b.get('token_estimate') else ''
    desc = b.get('description') or ''
    if desc and len(desc) > 40:
        desc = desc[:37] + '...'
    desc_str = f' - {desc}' if desc else ''
    # Infer type from source_config
    cfg = json.loads(b.get('source_config', '{}') or '{}')
    src_type = cfg.get('_migrated_source_type', 'manual')
    print(f'  {b[\"id\"]}  [{src_type}] {b[\"name\"]}{inject}{tokens}{desc_str}')
"
    fi
  fi
}

cmd_bases_show() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_show "$@"
    return
  fi
  require_bases_db
  local id="" json_out=false

  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    id="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      *) shift ;;
    esac
  done

  [[ -n "$id" ]] || die "Usage: jt bases show ID [--json]"

  local result
  result="$(sql_bases_json "SELECT * FROM bases WHERE id = '$(sql_escape "$id")';")"

  if [[ "$result" == "[]" ]]; then
    die "Base not found: $id"
  fi

  if $json_out; then
    echo "$result"
  else
    echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
b = data[0]
cfg = json.loads(b.get('source_config', '{}') or '{}')
src_type = cfg.get('_migrated_source_type', 'manual')
print(f'ID:          {b[\"id\"]}')
print(f'Name:        {b[\"name\"]}')
print(f'Project:     {b.get(\"project\", \"\")}')
print(f'Type:        {src_type}')
if b.get('description'):
    print(f'Description: {b[\"description\"]}')
if b.get('always_inject') == 1:
    print('Inject:      always')
if b.get('token_estimate'):
    print(f'Tokens:      ~{b[\"token_estimate\"]}')
if cfg.get('context_query'):
    print(f'Query:       {cfg[\"context_query\"]}')
# Extract text content from blocks
blocks = json.loads(b.get('blocks', '[]') or '[]')
text_parts = [bl['content'] for bl in blocks if bl.get('type') == 'text' and bl.get('content')]
if text_parts:
    content = '\n\n'.join(text_parts)
    if len(content) > 200:
        content = content[:197] + '...'
    print(f'Content:     {content}')
print(f'Created:     {b[\"created_at\"]}')
print(f'Updated:     {b[\"updated_at\"]}')
"
    # Show attached tasks
    local tasks
    tasks="$(sql_bases_json "SELECT task_id, attached_at FROM task_bases WHERE base_id = '$(sql_escape "$id")' ORDER BY attached_at;")"
    if [[ "$tasks" != "[]" ]]; then
      echo ""
      echo "Attached to tasks:"
      echo "$tasks" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for t in data:
    print(f'  {t[\"task_id\"]}  (attached {t[\"attached_at\"]})')
"
    fi
  fi
}

cmd_bases_create() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_create "$@"
    return
  fi
  require_bases_db
  local name="" source_type="" content="" description="" context_query="" project=""
  local always_inject=0 token_estimate="" json_out=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)          name="$2"; shift 2 ;;
      --type)          source_type="$2"; shift 2 ;;
      --content)       content="$2"; shift 2 ;;
      --description)   description="$2"; shift 2 ;;
      --query)         context_query="$2"; shift 2 ;;
      --project)       project="$2"; shift 2 ;;
      --always-inject) always_inject=1; shift ;;
      --tokens)        token_estimate="$2"; shift 2 ;;
      --json)          json_out=true; shift ;;
      *)               shift ;;
    esac
  done

  [[ -n "$name" ]] || die "Usage: jt bases create --name \"Name\" [--type TYPE] [--content \"...\"] [--description \"...\"] [--query \"SELECT ...\"] [--project NAME] [--always-inject] [--tokens N] [--json]"

  # Default project from directory name
  if [[ -z "$project" ]]; then
    project="$(basename "$PROJECT_ROOT")"
  fi

  local id ts
  id="$(gen_base_id)"
  ts="$(now_ts)"

  # Convert content to blocks JSON
  local blocks_json='[]'
  if [[ -n "$content" ]]; then
    local esc_block_content
    esc_block_content="$(echo "$content" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
    local block_id
    block_id="$(gen_base_id)"
    blocks_json="[{\"type\":\"text\",\"id\":\"$block_id\",\"content\":$esc_block_content}]"
  fi

  # Build source_config
  local source_config='{}'
  if [[ -n "$source_type" ]]; then
    validate_source_type "$source_type"
    source_config="{\"_migrated_source_type\":\"$source_type\"}"
  fi
  if [[ -n "$context_query" ]]; then
    local esc_cq
    esc_cq="$(echo "$context_query" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))')"
    source_config="$(echo "$source_config" | python3 -c "import sys,json; d=json.load(sys.stdin); d['context_query']=$esc_cq; print(json.dumps(d))")"
  fi

  local esc_name esc_desc esc_blocks esc_config esc_project
  esc_name="$(sql_escape "$name")"
  esc_desc="$(sql_escape "$description")"
  esc_blocks="$(sql_escape "$blocks_json")"
  esc_config="$(sql_escape "$source_config")"
  esc_project="$(sql_escape "$project")"

  local tok_val="NULL"
  if [[ -n "$token_estimate" ]]; then
    require_integer "$token_estimate" "token_estimate"
    tok_val="$token_estimate"
  fi

  sql_bases_exec "INSERT INTO bases (id, name, project, blocks, description, always_inject, token_estimate, source_config, created_at, updated_at) VALUES ('$id', '$esc_name', '$esc_project', '$esc_blocks', '$esc_desc', $always_inject, $tok_val, '$esc_config', '$ts', '$ts');"
  touch_sentinel

  if $json_out; then
    sql_bases_json "SELECT * FROM bases WHERE id = '$id';"
  else
    local type_label="${source_type:-manual}"
    echo "Created base: $id ($name) [$type_label]"
  fi
}

cmd_bases_delete() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_delete "$@"
    return
  fi
  require_bases_db
  local id="${1:-}" force=false
  shift 2>/dev/null || true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  [[ -n "$id" ]] || die "Usage: jt bases delete ID [--force]"

  # Verify exists
  local exists
  exists="$(sql_bases_json "SELECT id, name FROM bases WHERE id = '$(sql_escape "$id")';")"
  [[ "$exists" != "[]" ]] || die "Base not found: $id"

  if ! $force; then
    local bname
    bname="$(echo "$exists" | python3 -c "import sys,json; print(json.load(sys.stdin)[0]['name'])")"
    read -r -p "Delete base \"$bname\" ($id)? Task attachments will also be removed. [y/N] " confirm
    [[ "$confirm" =~ ^[yY] ]] || { echo "Cancelled."; return; }
  fi

  sql_bases_exec "DELETE FROM bases WHERE id = '$(sql_escape "$id")';"
  touch_sentinel
  echo "Deleted base: $id"
}

cmd_bases_attach() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_attach "$@"
    return
  fi
  require_bases_db
  local base_id="" task_id=""

  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    base_id="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task) task_id="$2"; shift 2 ;;
      *)      shift ;;
    esac
  done

  [[ -n "$base_id" && -n "$task_id" ]] || die "Usage: jt bases attach BASE_ID --task TASK_ID"

  # Verify base exists
  local exists
  exists="$(sql_bases_json "SELECT id FROM bases WHERE id = '$(sql_escape "$base_id")';")"
  [[ "$exists" != "[]" ]] || die "Base not found: $base_id"

  local ts
  ts="$(now_ts)"

  sql_bases_exec "INSERT OR IGNORE INTO task_bases (task_id, base_id, attached_at) VALUES ('$(sql_escape "$task_id")', '$(sql_escape "$base_id")', '$ts');"
  touch_sentinel
  echo "Attached base $base_id to task $task_id"
}

cmd_bases_detach() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_bases_detach "$@"
    return
  fi
  require_bases_db
  local base_id="" task_id=""

  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    base_id="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task) task_id="$2"; shift 2 ;;
      *)      shift ;;
    esac
  done

  [[ -n "$base_id" && -n "$task_id" ]] || die "Usage: jt bases detach BASE_ID --task TASK_ID"

  sql_bases_exec "DELETE FROM task_bases WHERE task_id = '$(sql_escape "$task_id")' AND base_id = '$(sql_escape "$base_id")';"

# pg_bases_create: create base via IDE API.
pg_bases_create() {
  local name="" source_type="" content="" description="" context_query="" project=""
  local always_inject=false token_estimate="" json_out=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)          name="$2"; shift 2 ;;
      --type)          source_type="$2"; shift 2 ;;
      --content)       content="$2"; shift 2 ;;
      --description)   description="$2"; shift 2 ;;
      --query)         context_query="$2"; shift 2 ;;
      --project)       project="$2"; shift 2 ;;
      --always-inject) always_inject=true; shift ;;
      --tokens)        token_estimate="$2"; shift 2 ;;
      --json)          json_out=true; shift ;;
      *)               shift ;;
    esac
  done

  [[ -n "$name" ]] || die "Usage: jt bases create --name \"Name\" [--type TYPE] [--content \"...\"] [--description \"...\"] [--query \"SELECT ...\"] [--project NAME] [--always-inject] [--tokens N] [--json]"

  local project_name
  project_name="$(_pg_project_or_die "$project")"

  if [[ -n "$source_type" ]]; then
    validate_source_type "$source_type"
  fi

  require_ide_reachable

  # Build JSON payload using jq to safely encode string values.
  local payload
  payload="$(jq -n \
    --arg project "$project_name" \
    --arg name    "$name" \
    --arg desc    "$description" \
    '{project: $project, name: $name} + (if $desc != "" then {description: $desc} else {} end)')"

  [[ -n "$source_type" ]]    && payload="$(echo "$payload" | jq --arg v "$source_type"    '. + {source_type: $v}')"
  [[ -n "$content" ]]        && payload="$(echo "$payload" | jq --arg v "$content"        '. + {content: $v}')"
  [[ -n "$context_query" ]]  && payload="$(echo "$payload" | jq --arg v "$context_query"  '. + {context_query: $v}')"
  $always_inject             && payload="$(echo "$payload" | jq                            '. + {always_inject: true}')"
  if [[ -n "$token_estimate" ]]; then
    require_integer "$token_estimate" "token_estimate"
    payload="$(echo "$payload" | jq --argjson v "$token_estimate" '. + {token_estimate: $v}')"
  fi

  local response
  response="$(pg_curl POST "/api/bases" "$payload")" || die "Failed to create base"
  _pg_check_err "$response" "Failed to create base"

  local new_base new_id new_name
  new_base="$(echo "$response" | jq '.base // .')"
  new_id="$(echo "$new_base" | jq -r '.id // ""')"
  new_name="$(echo "$new_base" | jq -r '.name // ""')"

  if $json_out; then
    echo "[$new_base]"
  else
    local type_label="${source_type:-manual}"
    echo "Created base: ${new_id} (${new_name}) [${type_label}]"
  fi
}

# pg_bases_delete: delete base via IDE API.
pg_bases_delete() {
  local id="" force=false project=""
  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then id="$1"; shift; fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)   force=true; shift ;;
      --project) project="$2"; shift 2 ;;
      *)         shift ;;
    esac
  done

  [[ -n "$id" ]] || die "Usage: jt bases delete ID [--force]"

  local project_name
  project_name="$(_pg_project_or_die "$project")"

  require_ide_reachable

  # Verify base exists and capture name for the prompt.
  local show_response
  show_response="$(pg_curl GET "/api/bases/${id}?project=$(_pg_urlencode "$project_name")")" \
    || die "Base not found: $id"
  if echo "$show_response" | jq -e '.error' >/dev/null 2>&1; then
    die "Base not found: $id"
  fi
  local bname
  bname="$(echo "$show_response" | jq -r '.base.name // ""')"

  if ! $force; then
    read -r -p "Delete base \"$bname\" ($id)? Task attachments will also be removed. [y/N] " confirm
    [[ "$confirm" =~ ^[yY] ]] || { echo "Cancelled."; return; }
  fi

  local response
  response="$(pg_curl DELETE "/api/bases/${id}?project=$(_pg_urlencode "$project_name")")" \
    || die "Failed to delete base: $id"
  _pg_check_err "$response" "Failed to delete base $id"
  echo "Deleted base: $id"
}


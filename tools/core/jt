DATA_SCHEMA='
CREATE TABLE IF NOT EXISTS _tables (
    name TEXT PRIMARY KEY,
    display_name TEXT,
    description TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS _columns (
    table_name TEXT NOT NULL,
    column_name TEXT NOT NULL,
    semantic_type TEXT NOT NULL,
    config TEXT DEFAULT '"'"'{}'"'"',
    display_name TEXT,
    description TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (table_name, column_name)
);
'

# Semantic type → SQLite type mapping
semantic_to_sqlite() {
  case "$1" in
    text)        echo "TEXT" ;;
    number)      echo "REAL" ;;
    boolean)     echo "INTEGER" ;;
    date)        echo "TEXT" ;;
    datetime)    echo "TEXT" ;;
    url)         echo "TEXT" ;;
    email)       echo "TEXT" ;;
    enum)        echo "TEXT" ;;
    currency)    echo "REAL" ;;
    percentage)  echo "REAL" ;;
    relation)    echo "TEXT" ;;
    formula)     echo "TEXT" ;;
    *)           echo "" ;;
  esac
}

# Run a read-only query against data.db, output JSON array
sql_data_json() {
  local out
  out="$(sqlite3 -json "$DATA_DB" "$1")"
  if [[ -z "$out" ]]; then
    echo "[]"
  else
    echo "$out"
  fi
}

# Run a write query against data.db
sql_data_exec() {
  sqlite3 "$DATA_DB" "PRAGMA foreign_keys=ON; $1"
}

# Validate table name: ^[a-zA-Z][a-zA-Z0-9_]{0,63}$, reject _ and sqlite_ prefixes
validate_table_name() {
  local name="$1"
  [[ -n "$name" ]] || die "Table name is required"
  [[ "$name" =~ ^[a-zA-Z][a-zA-Z0-9_]{0,63}$ ]] || die "Table name must start with a letter and contain only letters, numbers, and underscores (max 64 chars)"
  local lower
  lower="$(echo "$name" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower" != _* ]] || die "Table name cannot start with '_'"
  [[ "$lower" != sqlite_* ]] || die "Table name cannot start with 'sqlite_'"
}

# Ensure data.db exists, creating if needed
require_data_db() {
  if [[ ! -f "$DATA_DB" ]]; then
    local jat_dir="$PROJECT_ROOT/.jat"
    mkdir -p "$jat_dir"
    sqlite3 "$DATA_DB" "PRAGMA journal_mode=WAL; $DATA_SCHEMA"
  fi
}

# ---------------------------------------------------------------------------
# Postgres / IDE REST proxy helpers for `jt data`
# Used when backend=postgres. Each pg_data_* mirrors the matching cmd_data_*
# so output shape matches the SQLite path exactly.
# ---------------------------------------------------------------------------

# Resolve the project key name from projects.json, or die.
# Used as the ?project= query param when calling IDE endpoints.
_pg_data_project() {
  local name
  name="$(resolve_project_name)"
  [[ -n "$name" ]] || die "Cannot resolve project name for $PROJECT_ROOT. Register it in ~/.config/jat/projects.json."
  echo "$name"
}

# Extract {error} from a JSON response body, empty otherwise.
_pg_data_error() {
  echo "$1" | python3 -c "
import sys, json
try:
    d = json.loads(sys.stdin.read())
    if isinstance(d, dict) and d.get('error'):
        print(d['error'])
except Exception:
    pass
" 2>/dev/null
}

# Minimal URL-encoder for table names / view ids used in paths.
_pg_url_encode() {
  python3 -c "import sys, urllib.parse as u; print(u.quote(sys.argv[1], safe=''))" "$1"
}

# Call the IDE REST API, capturing the response body on any HTTP status so the
# caller can surface {error} from non-2xx JSON responses. pg_curl (used by
# task commands) uses -f which drops the body on 4xx/5xx; data commands want
# the full message instead of a generic "failed to …" die.
#
# Usage:  _pg_data_curl METHOD PATH [BODY_JSON]
# Echoes: response body (always)
# Exit:   0 on 2xx, 1 on non-2xx or network/curl error
_pg_data_curl() {
  local method="$1" path="$2" data="${3:-}"
  local port
  port="$(resolve_ide_port)"
  if [[ -z "$port" || "$port" == "null" ]]; then
    die "Cannot proxy to IDE: no port configured for this project in ~/.config/jat/projects.json"
  fi
  local tmp http_code
  tmp="$(mktemp)"
  if [[ -n "$data" ]]; then
    http_code="$(curl -s --max-time 30 -X "$method" "http://127.0.0.1:${port}${path}" \
      -H "Content-Type: application/json" --data "$data" \
      -o "$tmp" -w '%{http_code}' 2>/dev/null)"
  else
    http_code="$(curl -s --max-time 30 -X "$method" "http://127.0.0.1:${port}${path}" \
      -o "$tmp" -w '%{http_code}' 2>/dev/null)"
  fi
  local body
  body="$(cat "$tmp")"
  rm -f "$tmp"
  echo "$body"
  [[ "$http_code" =~ ^2 ]] && return 0
  return 1
}

# Run an IDE-proxied call and die on error, preferring the server's {error}
# message when present. Generic_msg is used when the server didn't send JSON.
# Echoes: response body on success (2xx, no {error})
# Usage:  response="$(_pg_data_call GET /path [body] "generic fail msg")"
_pg_data_call() {
  local method="$1" path="$2"
  local body_json="" generic_msg=""
  if [[ $# -eq 4 ]]; then
    body_json="$3"; generic_msg="$4"
  else
    generic_msg="$3"
  fi
  # `set -e` at the top of this script would kill the shell when the
  # command substitution returns non-zero; an `if !` makes the failure
  # explicit so we can surface the server's {error} message.
  local response err
  if response="$(_pg_data_curl "$method" "$path" "$body_json")"; then
    err="$(_pg_data_error "$response")"
    [[ -z "$err" ]] || die "$err"
    echo "$response"
    return 0
  fi
  err="$(_pg_data_error "$response")"
  die "${err:-$generic_msg}"
}

pg_data_tables() {
  local json_out=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      *) shift ;;
    esac
  done

  require_ide_reachable
  local project response
  project="$(_pg_data_project)"
  response="$(_pg_data_call GET "/api/data/tables?project=${project}" "Failed to list data tables")"

  if $json_out; then
    echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
tables = data.get('tables', []) or []
views = data.get('views', []) or []
counts = {}
for v in views:
    t = v.get('table_name', '')
    counts[t] = counts.get(t, 0) + 1
for t in tables:
    t['view_count'] = counts.get(t.get('name'), 0)
json.dump(tables, sys.stdout, indent=2)
print()
"
  else
    echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
tables = data.get('tables', []) or []
views = data.get('views', []) or []
if not tables:
    print('No data tables. Create one with: jt data create <table> col1:type1 col2:type2')
    sys.exit(0)
counts = {}
for v in views:
    t = v.get('table_name', '')
    counts[t] = counts.get(t, 0) + 1
for t in tables:
    vc = counts.get(t.get('name'), 0)
    views_str = f' ({vc} view{\"s\" if vc != 1 else \"\"})' if vc else ''
    desc = t.get('description') or '(no description)'
    print(f\"  {t['name']}{views_str} - {desc}\")
"
  fi
}

pg_data_schema() {
  local table_name="${1:-}"
  [[ -n "$table_name" ]] || die "Usage: jt data schema <table>"
  validate_table_name "$table_name"

  require_ide_reachable
  local project response
  project="$(_pg_data_project)"
  response="$(_pg_data_call GET "/api/data/tables/$(_pg_url_encode "$table_name")/schema?project=${project}" "Failed to fetch schema for $table_name")"

  echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
schema = data.get('schema', []) or []
meta = data.get('columnMeta', {}) or {}
for col in schema:
    name = col.get('name', '')
    typ = col.get('type', '') or ''
    notnull = col.get('notnull', 0)
    pk = col.get('pk', 0)
    nullable = 'not null' if notnull else 'nullable'
    pk_str = ' (PK)' if pk else ''
    sem = col.get('semanticType') or (meta.get(name, {}) or {}).get('semanticType') or ''
    sem_str = f' ({sem})' if sem else ''
    print(f'  {name} {typ}{sem_str} {nullable}{pk_str}')
"
}

pg_data_query() {
  local sql="${1:-}"
  [[ -n "$sql" ]] || die "Usage: jt data query \"SELECT ...\""

  if echo "$sql" | grep -qiE '^\s*(INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|REPLACE|ATTACH|DETACH)\b'; then
    die "Write operations not allowed in query mode. Use 'jt data exec' instead."
  fi

  if ! echo "$sql" | grep -qiE '\bLIMIT\b'; then
    sql="$(echo "$sql" | sed 's/;*\s*$/ LIMIT 100/')"
  fi

  require_ide_reachable
  local project response body
  project="$(_pg_data_project)"
  body="$(python3 -c 'import json,sys; print(json.dumps({"project":sys.argv[1],"sql":sys.argv[2]}))' "$project" "$sql")"
  response="$(_pg_data_call POST "/api/data/query" "$body" "Query failed")"

  echo "$response" | python3 -c "
import sys, json
d = json.load(sys.stdin)
rows = d.get('rows', []) or []
json.dump(rows, sys.stdout, indent=2)
print()
"
}

pg_data_exec() {
  local sql="${1:-}" force=false
  shift 2>/dev/null || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  [[ -n "$sql" ]] || die "Usage: jt data exec \"INSERT INTO ...\" [--force]"
  if ! echo "$sql" | grep -qiE '^\s*(INSERT|UPDATE|DELETE)\b'; then
    die "Only INSERT, UPDATE, DELETE statements are allowed"
  fi

  if ! $force; then
    echo "SQL: $sql"
    read -r -p "Execute? [y/N] " confirm
    [[ "$confirm" =~ ^[yY] ]] || { echo "Cancelled."; return; }
  fi

  require_ide_reachable
  local project body
  project="$(_pg_data_project)"
  body="$(python3 -c 'import json,sys; print(json.dumps({"project":sys.argv[1],"sql":sys.argv[2]}))' "$project" "$sql")"
  _pg_data_call POST "/api/data/exec" "$body" "Exec failed" >/dev/null
  echo "OK"
}

pg_data_create() {
  local table_name="${1:-}"
  [[ -n "$table_name" ]] || die "Usage: jt data create <table> col1:type1 col2:type2 ..."
  validate_table_name "$table_name"
  shift

  [[ $# -gt 0 ]] || die "At least one column required. Format: col_name:TYPE
Semantic types: text, number, boolean, date, datetime, url, email, enum, currency, percentage
SQLite types:   TEXT, INTEGER, REAL, BLOB, NUMERIC"

  # Build columns array JSON: [{name, type, semanticType?}]
  local cols_json="["
  local sep=""
  for arg in "$@"; do
    local col_name="${arg%%:*}"
    local col_type="${arg##*:}"
    [[ "$col_name" != "$arg" ]] || die "Invalid column format: $arg (expected name:type)"
    [[ -n "$col_name" ]] || die "Column name is required"
    [[ "$col_name" =~ ^[a-zA-Z][a-zA-Z0-9_]{0,63}$ ]] || die "Invalid column name: $col_name"

    local col_type_lower
    col_type_lower="$(echo "$col_type" | tr '[:upper:]' '[:lower:]')"
    local sqlite_type
    sqlite_type="$(semantic_to_sqlite "$col_type_lower")"

    local col_obj
    if [[ -n "$sqlite_type" ]]; then
      col_obj="$(python3 -c 'import json,sys; print(json.dumps({"name":sys.argv[1],"type":sys.argv[2],"semanticType":sys.argv[3]}))' "$col_name" "$sqlite_type" "$col_type_lower")"
    else
      local col_type_upper
      col_type_upper="$(echo "$col_type" | tr '[:lower:]' '[:upper:]')"
      case "$col_type_upper" in
        TEXT|INTEGER|REAL|BLOB|NUMERIC) ;;
        *) die "Invalid column type: $col_type
Semantic types: text, number, boolean, date, datetime, url, email, enum, currency, percentage
SQLite types:   TEXT, INTEGER, REAL, BLOB, NUMERIC" ;;
      esac
      col_obj="$(python3 -c 'import json,sys; print(json.dumps({"name":sys.argv[1],"type":sys.argv[2]}))' "$col_name" "$col_type_upper")"
    fi
    cols_json="${cols_json}${sep}${col_obj}"
    sep=","
  done
  cols_json="${cols_json}]"

  require_ide_reachable
  local project body
  project="$(_pg_data_project)"
  body="$(python3 -c '
import json, sys
print(json.dumps({
  "project": sys.argv[1],
  "name": sys.argv[2],
  "columns": json.loads(sys.argv[3])
}))
' "$project" "$table_name" "$cols_json")"
  _pg_data_call POST "/api/data/tables" "$body" "Failed to create table" >/dev/null
  echo "Created table: $table_name"
}

pg_data_drop() {
  local table_name="${1:-}" force=false
  shift 2>/dev/null || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  [[ -n "$table_name" ]] || die "Usage: jt data drop <table> [--force]"
  validate_table_name "$table_name"

  if ! $force; then
    read -r -p "Drop table \"$table_name\"? This cannot be undone. [y/N] " confirm
    [[ "$confirm" =~ ^[yY] ]] || { echo "Cancelled."; return; }
  fi

  require_ide_reachable
  local project
  project="$(_pg_data_project)"
  _pg_data_call DELETE "/api/data/tables?project=${project}&table=$(_pg_url_encode "$table_name")" "Failed to drop table" >/dev/null
  echo "Dropped table: $table_name"
}

pg_data_import() {
  local table_name="${1:-}"
  local file_path="${2:-}"
  [[ -n "$table_name" ]] || die "Usage: jt data import <table> <file> [--format tsv|csv] [--dry-run]"
  [[ -n "$file_path" ]] || die "Usage: jt data import <table> <file> [--format tsv|csv] [--dry-run]"
  validate_table_name "$table_name"
  shift 2

  [[ "$file_path" = /* ]] || file_path="$PWD/$file_path"
  [[ -f "$file_path" ]] || die "File not found: $file_path"

  local format="" dry_run=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format) format="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      *) shift ;;
    esac
  done

  if [[ -z "$format" ]]; then
    case "$file_path" in
      *.tsv) format="tsv" ;;
      *.csv) format="csv" ;;
      *.md)  format="tsv" ;;
      *)     format="tsv" ;;
    esac
  fi

  if $dry_run; then
    die "--dry-run is not yet supported on postgres-backed projects. Run without --dry-run."
  fi

  require_ide_reachable
  local project body response
  project="$(_pg_data_project)"
  body="$(python3 -c '
import json, sys
project, fmt, path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path, "r", encoding="utf-8") as f:
    text = f.read()
print(json.dumps({"project": project, "text": text, "format": fmt}))
' "$project" "$format" "$file_path")"

  response="$(_pg_data_call POST "/api/data/tables/$(_pg_url_encode "$table_name")/import" "$body" "Import failed")"

  echo "$response" | python3 -c "
import sys, json
d = json.load(sys.stdin)
inserted = d.get('inserted', 0)
cols = d.get('columns', {}) or {}
matched = cols.get('matched', []) or []
unmatched = cols.get('unmatched', []) or []
print(f'Imported {inserted} row(s).')
if unmatched:
    print(f\"  Skipped columns (not in table): {', '.join(unmatched)}\")
if matched:
    print(f\"  Matched columns: {', '.join(matched)}\")
"
}

pg_data_views() {
  local table_name="" json_out=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      --table) table_name="${2:-}"; shift 2 ;;
      -*) shift ;;
      *)
        if [[ -z "$table_name" ]]; then
          table_name="$1"
        fi
        shift ;;
    esac
  done

  require_ide_reachable
  local project response path
  project="$(_pg_data_project)"

  if [[ -n "$table_name" ]]; then
    validate_table_name "$table_name"
    path="/api/data/tables/$(_pg_url_encode "$table_name")/views?project=${project}"
  else
    path="/api/data/tables?project=${project}"
  fi
  response="$(_pg_data_call GET "$path" "Failed to list views")"

  echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
views = data.get('views', []) or []
json_out = '$json_out' == 'true'
table_filter = '$table_name'
if table_filter:
    views = [v for v in views if v.get('table_name') == table_filter]

if json_out:
    json.dump(views, sys.stdout, indent=2)
    print()
else:
    if not views:
        if table_filter:
            print(f\"No views for table '{table_filter}'. Create views in the IDE at /data.\")
        else:
            print('No views. Create views in the IDE at /data.')
    else:
        views.sort(key=lambda v: (v.get('table_name',''), v.get('name','')))
        cur_table = ''
        for v in views:
            t = v.get('table_name', '')
            if t != cur_table:
                cur_table = t
                print(f'  {cur_table}:')
            desc = v.get('description') or ''
            filters = v.get('filters') or []
            if isinstance(filters, str):
                try: filters = json.loads(filters)
                except: filters = []
            n = len(filters) if isinstance(filters, list) else 0
            filter_str = f' ({n} filter{\"s\" if n != 1 else \"\"})' if n else ''
            ctx = ' [context-view]' if v.get('context_query') else ''
            label = v.get('display_name') or v.get('name','')
            print(f\"    {v.get('id','')}  {label}{filter_str}{ctx} - {desc or '(no description)'}\")
"
}

pg_data_view() {
  local view_id="${1:-}" json_out=false
  shift 2>/dev/null || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      *) shift ;;
    esac
  done
  [[ -n "$view_id" ]] || die "Usage: jt data view <view-id> [--json]"

  require_ide_reachable
  local project response
  project="$(_pg_data_project)"
  response="$(_pg_data_call GET "/api/data/views/$(_pg_url_encode "$view_id")?project=${project}" "View not found: $view_id")"

  echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
v = data.get('view') or {}
json_out = '$json_out' == 'true'
for k in ('filters', 'visible_columns'):
    val = v.get(k)
    if isinstance(val, str):
        try: v[k] = json.loads(val)
        except: pass

if json_out:
    json.dump(v, sys.stdout, indent=2)
    print()
else:
    filters = v.get('filters') or []
    vis_cols = v.get('visible_columns')
    print(f'View: {v.get(\"display_name\") or v.get(\"name\", \"\")}')
    print(f'  ID:    {v.get(\"id\", \"\")}')
    print(f'  Table: {v.get(\"table_name\", \"\")}')
    if v.get('description'):
        print(f'  Desc:  {v[\"description\"]}')
    if filters:
        conj = v.get('filter_conjunction', 'AND')
        print(f'  Filters ({conj}):')
        for f in filters:
            print(f\"    {f.get('column','')} {f.get('operator','')} {f.get('value','')}\")
    if vis_cols:
        print(f'  Visible columns: {\", \".join(vis_cols)}')
    if v.get('sort_column'):
        print(f'  Sort: {v[\"sort_column\"]} {v.get(\"sort_direction\", \"ASC\")}')
    if v.get('context_query'):
        print(f'  Context query: {v[\"context_query\"]}')
    if v.get('context_description'):
        print(f'  Context desc:  {v[\"context_description\"]}')
"
}

pg_data_view_rows() {
  local view_id="${1:-}" json_out=false limit=100
  shift 2>/dev/null || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      --limit) limit="${2:-100}"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$view_id" ]] || die "Usage: jt data view-rows <view-id> [--json] [--limit N]"

  require_ide_reachable
  local project response
  project="$(_pg_data_project)"
  response="$(_pg_data_call GET "/api/data/views/$(_pg_url_encode "$view_id")/rows?project=${project}&resolve=true&limit=${limit}" "Failed to fetch view rows")"

  echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
rows = data.get('rows', []) or []
json_out = '$json_out' == 'true'

if not rows:
    if json_out:
        print('[]')
    else:
        print('(no rows match view filters)')
    sys.exit(0)

cols = [k for k in rows[0].keys() if k != 'rowid']
if json_out:
    clean = [{k: v for k, v in row.items() if k != 'rowid'} for row in rows]
    json.dump(clean, sys.stdout, indent=2, default=str)
    print()
else:
    def sanitize(v):
        s = str(v if v is not None else '').replace('\\n', ' ').replace('|', '\\\\|')
        return s[:117] + '...' if len(s) > 120 else s
    print('| ' + ' | '.join(cols) + ' |')
    print('| ' + ' | '.join('---' for _ in cols) + ' |')
    for row in rows:
        print('| ' + ' | '.join(sanitize(row.get(c)) for c in cols) + ' |')
    print(f'\\n({len(rows)} rows)')
"
}

cmd_data() {
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || { cmd_data_help; return; }
  shift

  case "$subcmd" in
    tables)    cmd_data_tables "$@" ;;
    schema)    cmd_data_schema "$@" ;;
    query)     cmd_data_query "$@" ;;
    exec)      cmd_data_exec "$@" ;;
    create)    cmd_data_create "$@" ;;
    drop)      cmd_data_drop "$@" ;;
    columns)   cmd_data_columns "$@" ;;
    import)    cmd_data_import "$@" ;;
    views)     cmd_data_views "$@" ;;
    view)      cmd_data_view "$@" ;;
    view-rows) cmd_data_view_rows "$@" ;;
    migrate-to-postgres) cmd_data_migrate_to_postgres "$@" ;;
    help|--help|-h) cmd_data_help ;;
    *)       die "Unknown data subcommand: $subcmd. Run 'jt data help' for usage." ;;
  esac
}

cmd_data_tables() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_data_tables "$@"
    return $?
  fi
  require_data_db
  local json_out=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_out=true; shift ;;
      *) shift ;;
    esac
  done

  # Check if _views table exists for view counts
  local has_views
  has_views="$(sqlite3 "$DATA_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='_views';" 2>/dev/null)"

  local result
  if [[ -n "$has_views" ]]; then
    result="$(sqlite3 -json "$DATA_DB" "
      SELECT t.name, t.display_name, t.description, t.created_at, t.updated_at,
             (SELECT COUNT(*) FROM _views v WHERE v.table_name = t.name) as view_count
      FROM _tables t
      ORDER BY t.name;
    ")"
  else
    result="$(sqlite3 -json "$DATA_DB" "
      SELECT t.name, t.display_name, t.description, t.created_at, t.updated_at, 0 as view_count
      FROM _tables t
      ORDER BY t.name;
    ")"
  fi
  [[ -n "$result" ]] || result="[]"

  if $json_out; then
    echo "$result"
  else
    if [[ "$result" == "[]" ]]; then
      echo "No data tables. Create one with: jt data create <table> col1:type1 col2:type2"
    else
      echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for t in data:
    vc = t.get('view_count', 0)
    views_str = f' ({vc} view{\"s\" if vc != 1 else \"\"})' if vc else ''
    print(f\"  {t['name']}{views_str} - {t.get('description', '') or '(no description)'}\")
"
    fi
  fi
}

cmd_data_schema() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_data_schema "$@"
    return $?
  fi
  require_data_db
  local table_name="${1:-}"
  [[ -n "$table_name" ]] || die "Usage: jt data schema <table>"
  validate_table_name "$table_name"

  # Load column metadata from _columns if it exists
  local meta_json="[]"
  local has_columns_table
  has_columns_table="$(sqlite3 "$DATA_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='_columns';" 2>/dev/null)"
  if [[ -n "$has_columns_table" ]]; then
    meta_json="$(sqlite3 -json "$DATA_DB" "SELECT column_name, semantic_type, config FROM _columns WHERE table_name = '$(sql_escape "$table_name")';" 2>/dev/null)"
    [[ -n "$meta_json" ]] || meta_json="[]"
  fi

  sqlite3 "$DATA_DB" "PRAGMA table_info(\"$table_name\");" | while IFS='|' read -r cid name type notnull dflt pk; do
    local nullable="nullable"
    [[ "$notnull" == "0" ]] || nullable="not null"
    local pk_str=""
    [[ "$pk" == "0" ]] || pk_str=" (PK)"

    # Look up semantic type for this column
    local sem_type=""
    if [[ "$meta_json" != "[]" ]]; then
      sem_type="$(echo "$meta_json" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for r in data:
    if r['column_name'] == '$name':
        print(r['semantic_type'])
        break
" 2>/dev/null)"
    fi

    if [[ -n "$sem_type" ]]; then
      echo "  $name $type ($sem_type) $nullable$pk_str"
    else
      echo "  $name $type $nullable$pk_str"
    fi
  done
}

cmd_data_query() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_data_query "$@"
    return $?
  fi
  require_data_db
  local sql="${1:-}"
  [[ -n "$sql" ]] || die "Usage: jt data query \"SELECT ...\""

  # Reject write statements
  if echo "$sql" | grep -qiE '^\s*(INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|REPLACE|ATTACH|DETACH)\b'; then
    die "Write operations not allowed in query mode. Use 'jt data exec' instead."
  fi

  # Auto-add LIMIT if missing
  if ! echo "$sql" | grep -qiE '\bLIMIT\b'; then
    sql="$(echo "$sql" | sed 's/;*\s*$/ LIMIT 100/')"
  fi

  sql_data_json "$sql"
}

cmd_data_exec() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_data_exec "$@"
    return $?
  fi
  require_data_db
  local sql="${1:-}" force=false
  shift 2>/dev/null || true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  [[ -n "$sql" ]] || die "Usage: jt data exec \"INSERT INTO ...\" [--force]"

  # Only allow INSERT, UPDATE, DELETE
  if ! echo "$sql" | grep -qiE '^\s*(INSERT|UPDATE|DELETE)\b'; then
    die "Only INSERT, UPDATE, DELETE statements are allowed"
  fi

  if ! $force; then
    echo "SQL: $sql"
    read -r -p "Execute? [y/N] " confirm
    [[ "$confirm" =~ ^[yY] ]] || { echo "Cancelled."; return; }
  fi

  sql_data_exec "$sql"
  touch_sentinel
  echo "OK"
}

cmd_data_create() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_data_create "$@"
    return $?
  fi
  require_data_db
  local table_name="${1:-}"
  [[ -n "$table_name" ]] || die "Usage: jt data create <table> col1:type1 col2:type2 ..."
  validate_table_name "$table_name"
  shift

  [[ $# -gt 0 ]] || die "At least one column required. Format: col_name:TYPE
Semantic types: text, number, boolean, date, datetime, url, email, enum, currency, percentage
SQLite types:   TEXT, INTEGER, REAL, BLOB, NUMERIC"

  local col_defs=""
  local sep=""
  # Track semantic columns for _columns metadata insertion
  local semantic_cols=()
  local semantic_types=()

  for arg in "$@"; do
    local col_name="${arg%%:*}"
    local col_type="${arg##*:}"
    [[ "$col_name" != "$arg" ]] || die "Invalid column format: $arg (expected name:type)"
    [[ -n "$col_name" ]] || die "Column name is required"
    [[ "$col_name" =~ ^[a-zA-Z][a-zA-Z0-9_]{0,63}$ ]] || die "Invalid column name: $col_name"

    # Check if it's a semantic type (lowercase)
    local col_type_lower
    col_type_lower="$(echo "$col_type" | tr '[:upper:]' '[:lower:]')"
    local sqlite_type
    sqlite_type="$(semantic_to_sqlite "$col_type_lower")"

    if [[ -n "$sqlite_type" ]]; then
      # Semantic type → map to SQLite and track for _columns
      col_defs="${col_defs}${sep}\"${col_name}\" ${sqlite_type}"
      semantic_cols+=("$col_name")
      semantic_types+=("$col_type_lower")
    else
      # Try raw SQLite type
      local col_type_upper
      col_type_upper="$(echo "$col_type" | tr '[:lower:]' '[:upper:]')"
      case "$col_type_upper" in
        TEXT|INTEGER|REAL|BLOB|NUMERIC) ;;
        *) die "Invalid column type: $col_type
Semantic types: text, number, boolean, date, datetime, url, email, enum, currency, percentage
SQLite types:   TEXT, INTEGER, REAL, BLOB, NUMERIC" ;;
      esac
      col_defs="${col_defs}${sep}\"${col_name}\" ${col_type_upper}"
    fi
    sep=", "
  done

  # Check if table already exists
  local exists
  exists="$(sqlite3 "$DATA_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='$(sql_escape "$table_name")';")"
  [[ -z "$exists" ]] || die "Table \"$table_name\" already exists"

  local ts
  ts="$(now_ts)"

  # Build SQL: create table + register in _tables + insert semantic column metadata
  local sql="
    CREATE TABLE \"$table_name\" ($col_defs);
    INSERT INTO _tables (name, display_name, description, created_at, updated_at)
    VALUES ('$(sql_escape "$table_name")', '$(sql_escape "$table_name")', '', '$ts', '$ts');
  "

  # Add _columns rows for semantic types
  local i
  for (( i=0; i<${#semantic_cols[@]}; i++ )); do
    sql="$sql
    INSERT INTO _columns (table_name, column_name, semantic_type, config, display_name, description, created_at, updated_at)
    VALUES ('$(sql_escape "$table_name")', '$(sql_escape "${semantic_cols[$i]}")', '${semantic_types[$i]}', '{}', NULL, NULL, '$ts', '$ts');
    "
  done

  sqlite3 "$DATA_DB" "$sql"
  touch_sentinel
  echo "Created table: $table_name"
}

cmd_data_drop() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    pg_data_drop "$@"
    return $?
  fi
  require_data_db
  local table_name="${1:-}" force=false
  shift 2>/dev/null || true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  [[ -n "$table_name" ]] || die "Usage: jt data drop <table> [--force]"
  validate_table_name "$table_name"

  if ! $force; then
    read -r -p "Drop table \"$table_name\"? This cannot be undone. [y/N] " confirm
    [[ "$confirm" =~ ^[yY] ]] || { echo "Cancelled."; return; }
  fi

  sqlite3 "$DATA_DB" "
    DROP TABLE IF EXISTS \"$table_name\";
    DELETE FROM _tables WHERE name = '$(sql_escape "$table_name")';
    DELETE FROM _columns WHERE table_name = '$(sql_escape "$table_name")';
  "
  touch_sentinel
  echo "Dropped table: $table_name"
}

cmd_data_columns() {
  if [[ "$(resolve_project_backend)" == "postgres" ]]; then
    die "'jt data columns' is not yet supported on postgres-backed projects. Manage column metadata via the JAT IDE at /data."
  fi
  require_data_db
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || die "Usage: jt data columns <list|set|remove> <table> [column] [type] [--config JSON]"
  shift

  case "$subcmd" in
    list)
      local table_name="${1:-}"
      [[ -n "$table_name" ]] || die "Usage: jt data columns list <table> [--json]"
      validate_table_name "$table_name"
      local json_out=false
      [[ "${2:-}" == "--json" ]] && json_out=true

      local has_columns_table
      has_columns_table="$(sqlite3 "$DATA_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='_columns';" 2>/dev/null)"
      if [[ -z "$has_columns_table" ]]; then
        $json_out && echo "[]" || echo "No column metadata. Set types with: jt data columns set <table> <column> <type>"
        return
      fi

      local result
      result="$(sqlite3 -json "$DATA_DB" "SELECT column_name, semantic_type, config FROM _columns WHERE table_name = '$(sql_escape "$table_name")' ORDER BY column_name;")"
      [[ -n "$result" ]] || result="[]"

      if $json_out; then
        echo "$result"
      else
        if [[ "$result" == "[]" ]]; then
          echo "No column metadata for $table_name. Set types with: jt data columns set $table_name <column> <type>"
        else
          echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for r in data:
    cfg = r.get('config', '{}')
    cfg_str = ''
    if cfg and cfg != '{}':
        cfg_str = f'  config={cfg}'
    print(f\"  {r['column_name']}: {r['semantic_type']}{cfg_str}\")
"
        fi
      fi
      ;;

    set)
      local table_name="${1:-}"
      local col_name="${2:-}"
      local sem_type="${3:-}"
      [[ -n "$table_name" && -n "$col_name" && -n "$sem_type" ]] || die "Usage: jt data columns set <table> <column> <type> [--config JSON]"
      validate_table_name "$table_name"
      [[ "$col_name" =~ ^[a-zA-Z][a-zA-Z0-9_]{0,63}$ ]] || die "Invalid column name: $col_name"

      sem_type="$(echo "$sem_type" | tr '[:upper:]' '[:lower:]')"
      local sqlite_type
      sqlite_type="$(semantic_to_sqlite "$sem_type")"
      [[ -n "$sqlite_type" ]] || die "Invalid semantic type: $sem_type
Valid types: text, number, boolean, date, datetime, url, email, enum, currency, percentage, relation, formula"

      local config="{}"
      shift 3
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --config) config="${2:-}"; shift 2 ;;
          *) shift ;;
        esac
      done

      local ts
      ts="$(now_ts)"
      sqlite3 "$DATA_DB" "
        INSERT INTO _columns (table_name, column_name, semantic_type, config, display_name, description, created_at, updated_at)
        VALUES ('$(sql_escape "$table_name")', '$(sql_escape "$col_name")', '$sem_type', '$(sql_escape "$config")', NULL, NULL, '$ts', '$ts')
        ON CONFLICT(table_name, column_name) DO UPDATE SET
          semantic_type = excluded.semantic_type,
          config = excluded.config,
          updated_at = excluded.updated_at;
      "
      touch_sentinel
      echo "Set $col_name → $sem_type on $table_name"
      ;;

    remove)
      local table_name="${1:-}"
      local col_name="${2:-}"
      [[ -n "$table_name" && -n "$col_name" ]] || die "Usage: jt data columns remove <table> <column>"
      validate_table_name "$table_name"

      sqlite3 "$DATA_DB" "DELETE FROM _columns WHERE table_name = '$(sql_escape "$table_name")' AND column_name = '$(sql_escape "$col_name")';"
      touch_sentinel
      echo "Removed metadata for $col_name on $table_name"
      ;;

    *)
      die "Unknown columns subcommand: $subcmd. Use: list, set, remove"
      ;;
  esac
}

